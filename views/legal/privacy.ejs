<!--! views/legal/privacy.ejs -->
<article class="legal-page" aria-labelledby="privacy-title">
	<header class="legal-hero">
		<p class="legal-kicker"><%= t('legal:privacy.kicker') %></p>
		<h1 id="privacy-title"><%= t('legal:privacy.title') %></h1>
		<p class="legal-summary"><%= t('legal:privacy.summary') %></p>
		<p class="legal-updated">
			<strong><%= t('legal:privacy.lastUpdatedLabel') %></strong>
			<time datetime="2026-09-17"><%= t('legal:privacy.lastUpdated') %></time>
		</p>
	</header>

	<nav class="legal-toc" aria-label="<%= t('legal:privacy.contentsLabel') %>">
		<h2><%= t('legal:privacy.contentsLabel') %></h2>
		<ul>
			<% t('legal:privacy.sections', { returnObjects: true }).forEach((section) => { %>
				<li><a href="#<%= section.id %>"><%= section.title %></a></li>
			<% }) %>
		</ul>
	</nav>

	<div class="legal-content">
		<% t('legal:privacy.sections', { returnObjects: true }).forEach((section) => { %>
			<section id="<%= section.id %>" class="legal-section">
				<h2><%= section.title %></h2>
				<% (section.paragraphs || []).forEach((paragraph) => { %>
					<p><%= paragraph %></p>
				<% }) %>
				<% if (section.items?.length) { %>
					<ul>
						<% section.items.forEach((item) => { %>
							<li><%= item %></li>
						<% }) %>
					</ul>
				<% } %>
				<% if (section.email) { %>
					<p>
						<strong><%= section.email.label %></strong>
						<a href="mailto:dakermanji@gmail.com">dakermanji@gmail.com</a>
					</p>
				<% } %>
			</section>
		<% }) %>
	</div>
</article>
