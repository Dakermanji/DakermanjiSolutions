<!--! views/layouts/main.ejs -->
<!DOCTYPE html>
<html
	lang="<%= currentLang %>"
	dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>"
	data-authenticated="<%= isAuthenticated ? 'true' : 'false' %>"
	data-theme-preference="<%= currentTheme %>"
	<% if (currentTheme === 'light' || currentTheme === 'dark') { %>
		data-theme="<%= currentTheme %>"
	<% } %>
>
	<%- include('_head') %>

	<body id="top">
		<a class="skip-link" href="#main-content"><%= t('skipToContent') %></a>
		<div id="app-shell">
			<%- include('_flash') %>

			<!-- Header -->
			<%- include('_navbar') %>

			<!-- Body (main contents) -->
			<main id="main-content" class="container" tabindex="-1"><%- body %></main>
			<% if (user) { %>
				<%- include('../social/main') %>
			<% } %>

			<!-- Footer -->
			<%- include('_footer') %>
		</div>
		<%- include('_mobileNavPanels') %>
		<div id="screen-too-small" role="alert" aria-live="polite">
			<h1><%= t('tooSmall.title') %></h1>
			<p><%= t('tooSmall.description') %></p>
		</div>
		<% if (modal) { %>
			<%- include('_modalStates') %>
		<% } %>
	</body>
</html>
