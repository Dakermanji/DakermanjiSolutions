<!--! views/layouts/_navUser.ejs -->
<% const safeNotificationUnreadCount = typeof notificationUnreadCount !== 'undefined' ? notificationUnreadCount : 0; %>
<% const safeNotificationPreview = typeof notificationPreview !== 'undefined' ? notificationPreview : []; %>
<% const keys = {
	notifications: t('nav.notifications'),
	notificationUnread: t('nav.unreadNotifications', { count: safeNotificationUnreadCount || 0 }),
	notificationUnreadTemplate: t('nav.unreadNotifications', { count: '{{count}}' }),
	profile: t('nav.profile'),
	social: t('nav.social'),
	signout: t('auth:signout.title')
}; %>
<% const notificationBadgeCount = Number(safeNotificationUnreadCount || 0); %>
<% const notificationPreviewItems = Array.isArray(safeNotificationPreview) ? safeNotificationPreview : []; %>

<li class="nav-item dropdown">
	<button id="presenceStatus" type="button" class="nav-link border-0 bg-transparent presence-trigger"
		data-presence-trigger data-bs-toggle="dropdown" aria-expanded="false"
		data-offline-status="<%= presenceStatuses.OFFLINE %>"
		data-status-labels="<%= JSON.stringify(Object.fromEntries(Object.values(presenceStatuses).map(status => [status, t('presence.statuses.' + status)]))) %>"
		aria-label="<%= t('presence.statuses.' + presenceStatuses.OFFLINE) %>" aria-describedby="presenceFeedback">
		<span class="nav-icon">
			<span class="presence-dot has-tooltip" data-presence-dot data-status="<%= presenceStatuses.OFFLINE %>"
				data-bs-title="<%= t('presence.statuses.' + presenceStatuses.OFFLINE) %>" aria-hidden="true"></span>
		</span>
		<span class="nav-text" data-presence-text><%= t('presence.statuses.' + presenceStatuses.OFFLINE) %></span>
	</button>
	<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="presenceStatus">
		<% presenceSelectableStatuses.forEach((status) => { %>
			<li><button type="button" class="dropdown-item d-flex align-items-center gap-2"
				data-presence-choice="<%= status %>" aria-pressed="false" disabled>
				<span class="presence-dot" data-status="<%= status %>" aria-hidden="true"></span>
				<%= t('presence.statuses.' + status) %>
			</button></li>
		<% }) %>
	</ul>
	<span id="presenceFeedback" class="visually-hidden" role="status" aria-live="polite"
		data-presence-feedback data-error="<%= t('presence.error') %>" data-connecting="<%= t('presence.connecting') %>"><%= t('presence.connecting') %></span>
</li>

<li class="nav-item ">
	<a
	class="nav-link has-tooltip <%= currentRoute === '/profile' ? 'active' : '' %>"
	id="profile"
	href="/profile"
	aria-label="<%= keys.profile %>"
	data-bs-title="<%= keys.profile %>"
	>
		<span class="nav-icon">
			<i class="bi bi-person-circle" aria-hidden="true"></i>
		</span>
		<span class="nav-text"><%= keys.profile %></span>
	</a>
</li>

<li class="nav-item dropdown d-none d-lg-block">
	<button
	class="nav-link border-0 bg-transparent <%= currentRoute === '/notifications' ? 'active' : '' %>"
	id="notificationsDropdown"
	type="button"
	aria-label="<%= keys.notifications %>"
	aria-expanded="false"
	data-bs-toggle="dropdown"
	data-bs-auto-close="outside"
	>
		<span class="nav-icon">
			<i class="bi bi-bell-fill" aria-hidden="true"></i>
			<span
				class="nav-badge"
				aria-label="<%= keys.notificationUnread %>"
				data-nav-badge="notificationsUnread"
				data-nav-badge-template="<%= keys.notificationUnreadTemplate %>"
				<% if (notificationBadgeCount <= 0) { %>
					hidden
				<% } %>
			>
				<%= new Intl.NumberFormat(currentLang || 'en').format(notificationBadgeCount) %>
			</span>
		</span>
		<span class="nav-text"><%= keys.notifications %></span>
	</button>

	<%- include('../notifications/_dropdown', { notificationBadgeCount, notificationPreviewItems, keys }) %>
</li>

<li class="nav-item d-lg-none">
	<a
	class="nav-link has-tooltip <%= currentRoute === '/notifications' ? 'active' : '' %>"
	id="notifications"
	href="/notifications"
	aria-label="<%= keys.notifications %>"
	data-bs-title="<%= keys.notifications %>"
	>
		<span class="nav-icon">
			<i class="bi bi-bell-fill" aria-hidden="true"></i>
			<span
				class="nav-badge"
				aria-label="<%= keys.notificationUnread %>"
				data-nav-badge="notificationsUnread"
				data-nav-badge-template="<%= keys.notificationUnreadTemplate %>"
				<% if (notificationBadgeCount <= 0) { %>
					hidden
				<% } %>
			>
				<%= new Intl.NumberFormat(currentLang || 'en').format(notificationBadgeCount) %>
			</span>
		</span>
		<span class="nav-text"><%= keys.notifications %></span>
	</a>
</li>

<li class="nav-item">
	<button
		type="button"
		class="nav-link has-tooltip border-0 bg-transparent"
		id="socialToggle"
		aria-label="<%= keys.social %>"
		aria-controls="socialPanel"
		aria-expanded="false"
		data-bs-title="<%= keys.social %>"
		data-bs-toggle="offcanvas"
		data-bs-target="#socialPanel"
	>
		<span class="nav-icon">
			<i class="bi bi-people-fill" aria-hidden="true"></i>
		</span>
		<span class="nav-text"><%= keys.social %></span>
	</button>
</li>

<li class="nav-item">
	<form action="/auth/signout" method="POST" class="d-inline">
		<%- include('../partials/_csrf') %>
			<button
			class="btn btn-link nav-link has-tooltip w-100"
			type="submit"
			aria-label="<%= keys.signout %>"
			data-bs-title="<%= keys.signout %>"
			>
				<span class="nav-icon">
					<i class="bi bi-box-arrow-right" aria-hidden="true"></i>
				</span>
				<span class="nav-text"><%= keys.signout %></span>
			</button>
	</form>
</li>
