<!--! views/layouts/_flash.ejs -->
<%
	const flashTypes = [
		{ key: 'error', style: 'danger', urgent: true },
		{ key: 'warning', style: 'warning', urgent: true },
		{ key: 'success', style: 'success', urgent: false },
		{ key: 'info', style: 'info', urgent: false },
	];
	const messages = [
		...(locals.errors || []).flat(Infinity).map((key) => ({ key, style: 'danger', urgent: true })),
		...flashTypes.flatMap(({ key, style, urgent }) =>
			(locals[key] || []).map((messageKey) => ({ key: messageKey, style, urgent }))
		),
	].filter(({ key }) => typeof key === 'string' && key.length > 0);
%>

<% if (messages.length) { %>
	<div class="flash-stack">
		<% messages.forEach(({ key, style, urgent }) => { %>
			<div
				class="flash-message alert alert-<%= style %> alert-dismissible fade show mb-0"
				role="<%= urgent ? 'alert' : 'status' %>"
				<% if (!urgent) { %>data-auto-dismiss<% } %>
			>
				<%= t(key) %>
				<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="<%= t('common:close') %>"></button>
			</div>
		<% }) %>
	</div>
<% } %>
