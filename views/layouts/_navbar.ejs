<!--! views/layouts/_navbar.ejs -->
<nav id='main-navbar' class="navbar navbar-expand-lg fixed-top ui-bar">
    <div class="container">
        <div class="navbar-brand-actions">
            <%- include('_navBrand') %>
            <button
                id="install-app"
                type="button"
                class="navbar-install-button has-tooltip"
                aria-label="<%= t('footer.installApp') %>"
                data-bs-title="<%= t('footer.installApp') %>"
                data-tooltip-always
                hidden
            >
                <i class="bi bi-download" aria-hidden="true"></i>
            </button>
        </div>
        <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="<%= t('nav:toggle') %>"
        >
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav <%= currentLang === 'ar' ? 'me-auto' : 'ms-auto' %>">
                <%- include('_navLinks') %>
                <% if (!user) { %>
                    <%- include('_navNotUser') %>
                <% } else { %>
                    <%- include('_navLinks', { navItems: typeof userAppsNavbar !== 'undefined' ? userAppsNavbar : [] }) %>
                    <%- include('_navUser') %>
                <% } %>
                <%- include('_navLang') %>
                <%- include('_navTheme') %>
            </ul>
        </div>
    </div>
</nav>
