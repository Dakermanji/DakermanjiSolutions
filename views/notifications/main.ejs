<!--! views/notifications/main.ejs -->
<%
	const items = Array.isArray(notifications) ? notifications : [];
	const unreadTotal = Number(unreadCount || 0);
	const formatCount = (value) => new Intl.NumberFormat(currentLang || 'en').format(Number(value || 0));
	const formatTime = (timestamp) => {
		if (!timestamp) return '';

		return new Intl.DateTimeFormat(currentLang || 'en', {
			dateStyle: 'medium',
			timeStyle: 'short',
		}).format(new Date(timestamp));
	};
	const getStatusKey = (notification) => {
		if (notification.isResponded) return 'responded';
		if (notification.isRead) return 'read';
		return 'unread';
	};
%>

<section
	class="notifications-page"
	aria-labelledby="notifications-title"
	data-notifications-page
	data-empty-filter-label="<%= t('notifications:filters.empty') %>"
>
	<header class="notifications-header">
		<div>
			<p class="notifications-kicker"><%= t('notifications:kicker') %></p>
			<h1 id="notifications-title"><%= t('notifications:title') %></h1>
		</div>

		<div class="notifications-summary" aria-label="<%= t('notifications:summary.unread', { count: unreadTotal }) %>">
			<span><%= formatCount(unreadTotal) %></span>
			<small><%= t('notifications:summary.unreadShort') %></small>
		</div>
	</header>

	<% if (items.length === 0) { %>
		<div class="notifications-empty">
			<i class="bi bi-bell" aria-hidden="true"></i>
			<p><%= t('notifications:empty') %></p>
		</div>
	<% } else { %>
		<div class="notifications-toolbar" role="group" aria-label="<%= t('notifications:filters.label') %>">
			<button
				class="notifications-filter is-active"
				type="button"
				data-notifications-filter="all"
				aria-pressed="true"
			>
				<i class="bi bi-inboxes-fill" aria-hidden="true"></i>
				<span><%= t('notifications:filters.all') %></span>
			</button>
			<button
				class="notifications-filter"
				type="button"
				data-notifications-filter="unread"
				aria-pressed="false"
			>
				<i class="bi bi-envelope-fill" aria-hidden="true"></i>
				<span><%= t('notifications:filters.unread') %></span>
			</button>
		</div>

		<p class="notifications-filter-empty" data-notifications-filter-empty hidden>
			<%= t('notifications:filters.empty') %>
		</p>

		<div class="notifications-list" data-notifications-list>
			<% items.forEach((notification) => { %>
				<%
					const title = notification.titleKey
						? t(notification.titleKey, notification.data)
						: t('notifications:item.fallbackTitle');
					const body = notification.bodyKey
						? t(notification.bodyKey, notification.data)
						: notification.actor.displayName || t('notifications:item.fallbackBody');
					const statusKey = getStatusKey(notification);
					const actions = Array.isArray(notification.actions) ? notification.actions : [];
				%>
				<article
					class="notification-item <%= notification.isRead ? 'is-read' : 'is-unread' %> priority-<%= notification.priority %>"
					data-notification-item
					data-notification-read="<%= notification.isRead ? 'true' : 'false' %>"
				>
					<div class="notification-icon" aria-hidden="true">
						<i class="bi bi-bell-fill"></i>
					</div>

					<a class="notification-content" href="<%= notification.linkUrl || '/notifications' %>">
						<span class="notification-meta">
							<span class="notification-chip"><%= t(`notifications:apps.${notification.appKey}`) %></span>
							<span class="notification-status"><%= t(`notifications:status.${statusKey}`) %></span>
						</span>
						<strong><%= title %></strong>
						<small><%= body %></small>
					</a>

					<div class="notification-side">
						<time
							class="notification-time"
							datetime="<%= notification.createdAt ? new Date(notification.createdAt).toISOString() : '' %>"
						>
							<%= formatTime(notification.createdAtTimestamp) %>
						</time>

						<% if (actions.length > 0) { %>
							<div class="notification-actions" aria-label="<%= t('notifications:actions.label') %>">
								<% actions.forEach((action) => { %>
									<form class="notification-action-form" action="<%= action.path %>" method="post">
										<input type="hidden" name="notificationId" value="<%= notification.id %>">
										<input type="hidden" name="entityType" value="<%= notification.entityType %>">
										<input type="hidden" name="entityId" value="<%= notification.entityId %>">
										<button
											class="notification-action notification-action--<%= action.key %> has-tooltip"
											type="submit"
											data-notification-action="<%= action.key %>"
											data-notification-id="<%= notification.id %>"
											data-notification-entity-type="<%= notification.entityType %>"
											data-notification-entity-id="<%= notification.entityId %>"
											data-bs-title="<%= t(action.tooltipKey) %>"
											aria-label="<%= t(action.tooltipKey) %>"
										>
											<i class="bi <%= action.icon %>" aria-hidden="true"></i>
										</button>
									</form>
								<% }) %>
							</div>
						<% } %>
					</div>
				</article>
			<% }) %>
		</div>
	<% } %>
</section>
