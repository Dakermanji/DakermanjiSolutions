<!--! views/kanban/projects.ejs -->
<section class="kanban-page" aria-labelledby="kanban-title">
	<header class="kanban-header">
		<div>
			<h1 id="kanban-title"><%= t('kanban:title') %></h1>
			<p><%= t('kanban:projectsDescription') %></p>
		</div>
		<button
			type="button"
			class="btn btn-action"
			data-bs-toggle="modal"
			data-bs-target="#createKanbanProjectModal"
		>
			<i class="bi bi-plus-lg" aria-hidden="true"></i>
			<%= t('kanban:createProject') %>
		</button>
	</header>

	<section class="kanban-panel kanban-invitations" aria-labelledby="kanban-invitations-title">
		<div class="kanban-section-heading">
			<h2 id="kanban-invitations-title"><%= t('kanban:yourInvitations') %></h2>
			<% if (declinedInvitations.length > 0) { %>
				<button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#declinedKanbanInvitationsModal">
					<%= t('kanban:declinedInvitations') %>
				</button>
			<% } %>
		</div>
		<% if (invitations.length === 0) { %>
			<p><%= t('kanban:noInvitations') %></p>
		<% } else { %>
			<ul class="kanban-invitation-list">
				<% invitations.forEach((invitation) => { %>
					<li>
						<div class="kanban-project-row">
							<div>
								<strong><%= invitation.project_name %></strong>
								<span class="badge text-bg-secondary"><%= t(`kanban:roles.${invitation.role}`) %></span>
								<time class="d-block" datetime="<%= new Date(invitation.expires_at).toISOString() %>">
									<%= t('kanban:invitationExpires', { date: new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium' }).format(new Date(invitation.expires_at)) }) %>
								</time>
							</div>
							<form method="POST" action="/kanban/invitations/accept">
								<%- include('../partials/_csrf') %>
								<input type="hidden" name="invitationId" value="<%= invitation.id %>" />
								<button type="submit" class="btn btn-action btn-sm"><%= t('kanban:acceptInvitation') %></button>
								<button type="submit" formaction="/kanban/invitations/decline" class="btn btn-outline-secondary btn-sm"><%= t('kanban:declineInvitation') %></button>
							</form>
						</div>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>

	<section class="kanban-panel" aria-labelledby="kanban-projects-title">
		<h2 id="kanban-projects-title"><%= t('kanban:yourProjects') %></h2>
		<% if (projects.length === 0) { %>
			<p><%= t('kanban:noProjects') %></p>
		<% } else { %>
			<ul class="kanban-project-list">
				<% projects.forEach((project) => { %>
					<li>
						<div class="kanban-project-row">
							<div>
								<a href="/kanban/<%= project.id %>"><%= project.name %></a>
								<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
							</div>
							<% if (project.role === 'owner') { %>
								<button
								type="button"
								class="btn btn-outline-danger btn-sm"
								data-bs-toggle="modal"
								data-bs-target="#archiveKanbanProjectModal"
								data-project-id="<%= project.id %>"
								data-project-name="<%= project.name %>"
								aria-label="<%= t('kanban:deleteProjectNamed', { name: project.name }) %>"
							>
								<i class="bi bi-trash" aria-hidden="true"></i>
							</button>
							<% } %>
						</div>
						<% if (project.description) { %>
							<p><%= project.description %></p>
						<% } %>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>
	<% if (archivedProjects.length > 0) { %>
		<section class="kanban-panel" aria-labelledby="kanban-archived-projects-title">
			<h2 id="kanban-archived-projects-title"><%= t('kanban:archivedProjects') %></h2>
			<ul class="kanban-project-list">
				<% archivedProjects.forEach((project) => { %>
					<li>
						<div class="kanban-project-row">
							<strong><%= project.name %></strong>
							<time datetime="<%= new Date(project.archived_at).toISOString() %>">
								<%= t('kanban:archivedOn') %>
								<%= new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium' }).format(new Date(project.archived_at)) %>
							</time>
							<div class="kanban-project-actions">
								<form method="POST" action="/kanban/restore">
									<%- include('../partials/_csrf') %>
									<input type="hidden" name="projectId" value="<%= project.id %>" />
									<button type="submit" class="btn btn-outline-success btn-sm">
										<i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
										<%= t('kanban:restoreProject') %>
									</button>
								</form>
								<button
									type="button"
									class="btn btn-outline-danger btn-sm"
									data-bs-toggle="modal"
									data-bs-target="#permanentlyDeleteKanbanProjectModal"
									data-project-id="<%= project.id %>"
									data-project-name="<%= project.name %>"
									data-tooltip-mobile
									data-bs-title="<%= t('kanban:permanentlyDeleteProjectNamed', { name: project.name }) %>"
									aria-label="<%= t('kanban:permanentlyDeleteProjectNamed', { name: project.name }) %>"
								>
									<i class="bi bi-trash" aria-hidden="true"></i>
									<span class="kanban-action-label"><%= t('kanban:permanentlyDeleteProject') %></span>
								</button>
							</div>
						</div>
						<% if (project.description) { %>
							<p><%= project.description %></p>
						<% } %>
					</li>
				<% }) %>
			</ul>
		</section>
	<% } %>
</section>

<%- include('../modals/kanban/_create_project_modal') %>
<% if (declinedInvitations.length > 0) { %>
	<%- include('../modals/kanban/_declined_invitations_modal') %>
<% } %>
<% if (projects.some((project) => project.role === 'owner')) { %>
	<%- include('../modals/kanban/_archive_project_modal') %>
<% } %>
<% if (archivedProjects.length > 0) { %>
	<%- include('../modals/kanban/_permanently_delete_project_modal') %>
<% } %>
