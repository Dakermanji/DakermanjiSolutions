<!--! views/kanban/projects.ejs -->
<section class="kanban-page" aria-labelledby="kanban-title">
	<header class="kanban-header">
		<div>
			<h1 id="kanban-title"><%= t('kanban:title') %></h1>
			<p><%= t('kanban:projectsDescription') %></p>
		</div>
		<button
			type="button"
			class="btn btn-action"
			data-bs-toggle="modal"
			data-bs-target="#createKanbanProjectModal"
		>
			<i class="bi bi-plus-lg" aria-hidden="true"></i>
			<%= t('kanban:createProject') %>
		</button>
	</header>

	<section class="kanban-panel kanban-invitations" aria-labelledby="kanban-invitations-title">
		<h2 id="kanban-invitations-title"><%= t('kanban:yourInvitations') %></h2>
		<% if (invitations.length === 0) { %>
			<p><%= t('kanban:noInvitations') %></p>
		<% } else { %>
			<ul class="kanban-invitation-list">
				<% invitations.forEach((invitation) => { %>
					<li>
						<div class="kanban-project-row">
							<strong dir="auto"><%= invitation.project_name %></strong>
							<span class="badge text-bg-secondary"><%= t(`kanban:roles.${invitation.role}`) %></span>
						</div>
						<time datetime="<%= new Date(invitation.expires_at).toISOString() %>">
							<%= t('kanban:invitationExpires', { date: new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium' }).format(new Date(invitation.expires_at)) }) %>
						</time>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>

	<section class="kanban-panel" aria-labelledby="kanban-projects-title">
		<h2 id="kanban-projects-title"><%= t('kanban:yourProjects') %></h2>
		<% if (projects.length === 0) { %>
			<p><%= t('kanban:noProjects') %></p>
		<% } else { %>
			<ul class="kanban-project-list">
				<% projects.forEach((project) => { %>
					<li>
						<div class="kanban-project-row">
							<div>
								<a href="/kanban/<%= project.id %>"><%= project.name %></a>
								<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
							</div>
							<% if (project.role === 'owner') { %>
								<button
								type="button"
								class="btn btn-outline-danger btn-sm"
								data-bs-toggle="modal"
								data-bs-target="#archiveKanbanProjectModal"
								data-project-id="<%= project.id %>"
								data-project-name="<%= project.name %>"
								aria-label="<%= t('kanban:deleteProjectNamed', { name: project.name }) %>"
							>
								<i class="bi bi-trash" aria-hidden="true"></i>
							</button>
							<% } %>
						</div>
						<% if (project.description) { %>
							<p><%= project.description %></p>
						<% } %>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>
</section>

<%- include('../modals/kanban/_create_project_modal') %>
<% if (projects.some((project) => project.role === 'owner')) { %>
	<%- include('../modals/kanban/_archive_project_modal') %>
<% } %>
