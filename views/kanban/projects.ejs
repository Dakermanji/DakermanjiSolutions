<!--! views/kanban/projects.ejs -->
<section class="kanban-page" aria-labelledby="kanban-title">
	<header class="kanban-header">
		<div>
			<h1 id="kanban-title"><%= t('kanban:title') %></h1>
			<p><%= t('kanban:projectsDescription') %></p>
		</div>
		<button
			type="button"
			class="btn btn-action"
			data-bs-toggle="modal"
			data-bs-target="#createKanbanProjectModal"
		>
			<i class="bi bi-plus-lg" aria-hidden="true"></i>
			<%= t('kanban:createProject') %>
		</button>
	</header>

	<section class="kanban-panel" aria-labelledby="kanban-projects-title">
		<h2 id="kanban-projects-title"><%= t('kanban:yourProjects') %></h2>
		<% if (projects.length === 0) { %>
			<p><%= t('kanban:noProjects') %></p>
		<% } else { %>
			<ul class="kanban-project-list">
				<% projects.forEach((project) => { %>
					<li>
						<a href="/kanban/<%= project.id %>"><%= project.name %></a>
						<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
						<% if (project.description) { %>
							<p><%= project.description %></p>
						<% } %>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>
</section>

<%- include('_create_project_modal') %>
