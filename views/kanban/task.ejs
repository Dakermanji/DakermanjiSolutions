<!--! views/kanban/task.ejs -->
<section class="kanban-page" aria-labelledby="task-title"
	data-due-ended="<%= t('kanban:dueStates.ended') %>"
	data-due-within-24="<%= t('kanban:dueStates.within24') %>"
	data-due-later="<%= t('kanban:dueStates.later') %>"
	data-kanban-mention-members="<%= JSON.stringify(mentionMembers) %>"
>
	<div class="kanban-context-row">
		<a href="/kanban/<%= task.project_id %>" class="kanban-back"><%= t('kanban:backToProject') %></a>
		<span class="badge text-bg-secondary"><%= t(`kanban:roles.${task.viewer_role}`) %></span>
	</div>
	<header class="kanban-header">
		<div>
			<p><%= task.project_name %></p>
			<h1 id="task-title"><%= task.title %></h1>
		</div>
		<div class="kanban-project-actions">
			<a href="/kanban/tasks/<%= task.id %>/activity" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:taskActivity') %>" aria-label="<%= t('kanban:taskActivity') %>">
				<i class="bi bi-clock-history" aria-hidden="true"></i>
				<span class="kanban-action-label"><%= t('kanban:taskActivity') %></span>
			</a>
			<% if (canEditTask) { %>
				<button type="button" class="btn btn-action btn-sm" data-bs-toggle="modal" data-bs-target="#editKanbanTaskModal" data-tooltip-mobile data-bs-title="<%= t('kanban:editTask') %>" aria-label="<%= t('kanban:editTask') %>">
					<i class="bi bi-pencil-square" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:editTask') %></span>
				</button>
				<button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#archiveKanbanTaskModal" data-task-id="<%= task.id %>" data-task-title="<%= task.title %>" data-tooltip-mobile data-bs-title="<%= t('kanban:archiveTask') %>" aria-label="<%= t('kanban:archiveTaskNamed', { name: task.title }) %>">
					<i class="bi bi-archive" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:archiveTask') %></span>
				</button>
			<% } %>
		</div>
	</header>

	<section class="kanban-panel" aria-labelledby="task-details-title">
		<h2 id="task-details-title"><%= t('kanban:taskDetails') %></h2>
		<dl class="kanban-task-details">
			<div>
				<dt><%= t('kanban:status') %></dt>
				<dd>
					<% if (canChangeStage) { %>
						<form method="POST" action="/kanban/tasks/stage" class="d-flex flex-wrap gap-2" data-kanban-change-form>
							<%- include('../partials/_csrf') %>
							<input type="hidden" name="taskId" value="<%= task.id %>">
							<label for="task-stage" class="visually-hidden"><%= t('kanban:status') %></label>
							<select id="task-stage" name="status" class="form-select w-auto" data-app-select data-initial-value="<%= task.status %>" data-kanban-change-select>
								<% taskStages.forEach((stage) => { %>
									<option value="<%= stage %>" <%= stage === task.status ? 'selected' : '' %>><%= t(`kanban:taskStages.${stage}`) %></option>
								<% }) %>
							</select>
							<button type="submit" class="btn btn-action" data-kanban-change-submit hidden><%= t('kanban:updateStage') %></button>
						</form>
					<% } else { %>
						<%= t(`kanban:taskStages.${task.status}`) %>
					<% } %>
				</dd>
			</div>
			<div>
				<dt><%= t('kanban:assignedTo') %></dt>
				<dd>
					<% if (canChangeAssignee) { %>
						<form method="POST" action="/kanban/tasks/assign" class="d-flex flex-wrap gap-2" data-kanban-change-form>
							<%- include('../partials/_csrf') %>
							<input type="hidden" name="taskId" value="<%= task.id %>">
							<label for="task-assignee-change" class="visually-hidden"><%= t('kanban:assignedTo') %></label>
							<select id="task-assignee-change" name="assigneeUserId" dir="ltr" class="form-select w-auto" data-app-select data-initial-value="<%= task.assignee_user_id || '' %>" data-kanban-change-select>
								<% if (canEditTask) { %>
									<option value="" <%= !task.assignee_user_id ? 'selected' : '' %>><%= t('kanban:unassigned') %></option>
								<% } else { %>
									<option value="<%= task.assignee_user_id %>" selected><%= task.assignee_username || task.assignee_email %> (<%= t(`kanban:roles.${task.viewer_role}`) %>)</option>
								<% } %>
								<% assignableMembers.forEach((member) => { %>
									<option value="<%= member.user_id %>" <%= member.user_id === task.assignee_user_id ? 'selected' : '' %>><%= member.username || member.email %> (<%= t(`kanban:roles.${member.role}`) %>)</option>
								<% }) %>
							</select>
							<button type="submit" class="btn btn-action" data-kanban-change-submit hidden><%= t('kanban:updateAssignee') %></button>
						</form>
					<% } else { %>
						<%= task.assignee_username || task.assignee_email || t('kanban:unassigned') %>
					<% } %>
				</dd>
			</div>
			<div>
				<dt><%= t('kanban:createdBy') %></dt>
				<dd><%= task.creator_username || task.creator_email || t('kanban:events.formerMember') %></dd>
			</div>
			<div>
				<dt><%= t('kanban:dueDate') %></dt>
				<dd class="kanban-task-due-date">
					<% if (task.due_date) { %>
						<span class="kanban-task-due-icon" data-kanban-due-date="<%= task.due_date %>" role="img" tabindex="0" aria-label="<%= t('kanban:dueDate') %>">
							<span class="kanban-task-due-emoji" aria-hidden="true">📅</span>
						</span>
						<time datetime="<%= task.due_date %>"><%= new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(`${task.due_date}T00:00:00Z`)) %></time>
					<% } else { %>
						<%= t('kanban:noDueDate') %>
					<% } %>
				</dd>
			</div>
			<div>
				<dt><%= t('kanban:importance') %></dt>
				<dd class="kanban-task-importance">
					<% if (task.importance) { %>
						<span class="kanban-task-importance-emoji" aria-hidden="true"><%= importanceEmojis[task.importance] %></span>
					<% } %>
					<%= task.importance ? t(`kanban:importanceLevels.${task.importance}`) : t('kanban:noImportance') %>
				</dd>
			</div>
		</dl>
		<h2><%= t('kanban:description') %></h2>
		<p class="kanban-task-description" dir="auto"><%= task.description || t('kanban:noDescription') %></p>
	</section>

	<section class="kanban-panel mt-4" id="task-discussion" aria-labelledby="task-discussion-title">
		<h2 id="task-discussion-title"><%= t('kanban:taskDiscussion') %></h2>
		<form method="POST" action="/kanban/tasks/messages" class="mb-4">
			<%- include('../partials/_csrf') %>
			<input type="hidden" name="taskId" value="<%= task.id %>">
			<div class="mb-3">
				<label id="task-message-body-label" class="form-label"><%= t('kanban:taskMessage') %></label>
				<div class="kanban-mention-control">
					<div id="kanban-task-message-mention-menu" class="kanban-mention-menu" data-kanban-mention-menu role="listbox" dir="ltr" aria-label="<%= t('chat:conversation.mentionSuggestions') %>" hidden></div>
					<div id="task-message-body" class="form-control kanban-mention-editor" contenteditable="true" role="textbox" aria-labelledby="task-message-body-label" aria-multiline="true" aria-required="true" aria-autocomplete="list" aria-controls="kanban-task-message-mention-menu" aria-expanded="false" dir="auto" data-kanban-mention-input data-max-length="<%= taskMessageLimits.BODY_MAX_LENGTH %>"></div>
					<textarea name="body" data-kanban-mention-value hidden></textarea>
				</div>
			</div>
			<button type="submit" class="btn btn-action"><%= t('kanban:sendTaskMessage') %></button>
		</form>
		<% if (messages.length === 0) { %>
			<p><%= t('kanban:noTaskMessages') %></p>
		<% } else { %>
			<% const roleIcons = { owner: 'bi-crown-fill', admin: 'bi-shield-check', editor: 'bi-pencil-square', observer: 'bi-eye' }; %>
			<ul class="kanban-message-list">
				<% messages.forEach((message) => { %>
					<li class="kanban-message">
						<div class="kanban-message-meta">
							<strong><%= message.author_username || t(message.author_user_id ? 'kanban:member' : 'kanban:events.formerMember') %></strong>
							<span class="kanban-message-role" aria-label="<%= t(`kanban:roles.${message.author_role}`) %>">
								<i class="bi <%= roleIcons[message.author_role] %>" aria-hidden="true"></i>
								<span><%= t(`kanban:roles.${message.author_role}`) %></span>
							</span>
							<% if (message.author_user_id === message.assignee_user_id) { %>
								<span class="badge text-bg-info"><%= t('kanban:taskAssignee') %></span>
							<% } %>
							<time datetime="<%= new Date(message.created_at).toISOString() %>">
								<%= new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(message.created_at)) %>
							</time>
							<% if (message.edited_at) { %>
								<span class="small text-body-secondary"><%= t('kanban:commentEdited') %></span>
							<% } %>
						</div>
						<p class="kanban-message-body" dir="auto"><% message.bodyParts.forEach((part) => { %><% if (part.isMention) { %><span class="app-mention"><%= part.text %></span><% } else { %><%= part.text %><% } %><% }) %></p>
						<% if (message.can_edit) { %>
							<details class="mt-3">
								<summary><%= t('kanban:editTaskComment') %></summary>
								<form method="POST" action="/kanban/tasks/messages/edit" class="mt-2">
									<%- include('../partials/_csrf') %>
									<input type="hidden" name="taskId" value="<%= task.id %>">
									<input type="hidden" name="messageId" value="<%= message.id %>">
									<label id="edit-task-comment-label-<%= message.id %>" class="visually-hidden"><%= t('kanban:taskMessage') %></label>
									<div class="kanban-mention-control">
										<div id="kanban-task-comment-mention-menu-<%= message.id %>" class="kanban-mention-menu" data-kanban-mention-menu role="listbox" dir="ltr" aria-label="<%= t('chat:conversation.mentionSuggestions') %>" hidden></div>
										<div id="edit-task-comment-<%= message.id %>" class="form-control kanban-mention-editor mb-2" contenteditable="true" role="textbox" aria-labelledby="edit-task-comment-label-<%= message.id %>" aria-multiline="true" aria-required="true" aria-autocomplete="list" aria-controls="kanban-task-comment-mention-menu-<%= message.id %>" aria-expanded="false" dir="auto" data-kanban-mention-input data-max-length="<%= taskMessageLimits.BODY_MAX_LENGTH %>"><% message.bodyParts.forEach((part) => { %><% if (part.isMention) { %><span class="app-mention" data-kanban-mention-token><%= part.text %></span><% } else { %><%= part.text %><% } %><% }) %></div>
										<textarea name="body" data-kanban-mention-value hidden><%= message.body %></textarea>
									</div>
									<button type="submit" class="btn btn-outline-secondary btn-sm"><%= t('kanban:saveTaskComment') %></button>
								</form>
							</details>
						<% } %>
					</li>
				<% }) %>
			</ul>
		<% } %>
	</section>
</section>

<% if (canEditTask) { %>
	<%- include('../modals/kanban/_edit_task_modal') %>
	<%- include('../modals/kanban/_archive_task_modal') %>
<% } %>
