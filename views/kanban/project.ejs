<!--! views/kanban/project.ejs -->
<section class="kanban-page" aria-labelledby="project-title">
	<div class="kanban-context-row">
		<a href="/kanban" class="kanban-back"><%= t('kanban:allProjects') %></a>
		<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
	</div>
	<header class="kanban-header">
		<div>
			<h1 id="project-title"><%= project.name %></h1>
			<% if (project.description) { %>
				<p><%= project.description %></p>
			<% } %>
		</div>
		<div class="kanban-project-actions">
			<% if (canCreateTask) { %>
				<button type="button" class="btn btn-action btn-sm" data-bs-toggle="modal" data-bs-target="#createKanbanTaskModal" data-tooltip-mobile data-bs-title="<%= t('kanban:createTask') %>" aria-label="<%= t('kanban:createTask') %>">
					<i class="bi bi-plus-lg" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:createTask') %></span>
				</button>
			<% } %>
			<a href="/kanban/<%= project.id %>/members" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:members') %>" aria-label="<%= t('kanban:members') %>">
				<i class="bi bi-people" aria-hidden="true"></i>
				<span class="kanban-action-label"><%= t('kanban:members') %></span>
			</a>
			<a href="/kanban/<%= project.id %>/activity" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:projectActivity') %>" aria-label="<%= t('kanban:projectActivity') %>">
				<i class="bi bi-clock-history" aria-hidden="true"></i>
				<span class="kanban-action-label"><%= t('kanban:projectActivity') %></span>
			</a>
			<% if (project.role === 'owner') { %>
				<button
					type="button"
					class="btn btn-outline-danger btn-sm"
					data-bs-toggle="modal"
					data-bs-target="#archiveKanbanProjectModal"
					data-project-id="<%= project.id %>"
					data-project-name="<%= project.name %>"
					data-tooltip-mobile
					data-bs-title="<%= t('kanban:deleteProject') %>"
					aria-label="<%= t('kanban:deleteProjectNamed', { name: project.name }) %>"
				>
					<i class="bi bi-trash" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:deleteProject') %></span>
				</button>
			<% } %>
		</div>
	</header>

	<% const stages = ['pending', 'in_progress', 'done']; %>
	<div class="kanban-board" role="group" aria-label="<%= t('kanban:taskBoard') %>">
		<% stages.forEach((stage) => { %>
			<% const stageTasks = tasks.filter((task) => task.status === stage); %>
			<section class="kanban-panel kanban-column" aria-labelledby="kanban-stage-<%= stage %>">
				<div class="kanban-column-heading">
					<h2 id="kanban-stage-<%= stage %>"><%= t(`kanban:taskStages.${stage}`) %></h2>
					<span class="badge text-bg-secondary"><%= new Intl.NumberFormat(currentLang || 'en').format(stageTasks.length) %></span>
				</div>
				<% if (stageTasks.length === 0) { %>
					<p class="kanban-column-empty"><%= t('kanban:noTasksInStage') %></p>
				<% } else { %>
					<ul class="kanban-task-list">
						<% stageTasks.forEach((task) => { %>
							<li class="kanban-task-card">
								<h3 dir="auto"><%= task.title %></h3>
							</li>
						<% }) %>
					</ul>
				<% } %>
			</section>
		<% }) %>
	</div>
</section>

<% if (canCreateTask) { %>
	<%- include('../modals/kanban/_create_task_modal') %>
<% } %>
<% if (project.role === 'owner') { %>
	<%- include('../modals/kanban/_archive_project_modal') %>
<% } %>
