<!--! views/kanban/project.ejs -->
<section class="kanban-page" aria-labelledby="project-title"
	data-due-ended="<%= t('kanban:dueStates.ended') %>"
	data-due-within-24="<%= t('kanban:dueStates.within24') %>"
	data-due-later="<%= t('kanban:dueStates.later') %>"
>
	<div class="kanban-context-row">
		<a href="/kanban" class="kanban-back"><%= t('kanban:allProjects') %></a>
		<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
	</div>
	<header class="kanban-header">
		<div>
			<h1 id="project-title"><%= project.name %></h1>
			<% if (project.description) { %>
				<p><%= project.description %></p>
			<% } %>
		</div>
		<div class="kanban-project-actions">
			<% if (canCreateTask) { %>
				<a href="/kanban/<%= project.id %>/archived-tasks" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:archivedTasks') %>" aria-label="<%= t('kanban:archivedTasks') %>">
					<i class="bi bi-archive" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:archivedTasks') %></span>
				</a>
				<button type="button" class="btn btn-action btn-sm" data-bs-toggle="modal" data-bs-target="#createKanbanTaskModal" data-tooltip-mobile data-bs-title="<%= t('kanban:createTask') %>" aria-label="<%= t('kanban:createTask') %>">
					<i class="bi bi-plus-lg" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:createTask') %></span>
				</button>
			<% } %>
			<a href="/kanban/<%= project.id %>/members" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:members') %>" aria-label="<%= t('kanban:members') %>">
				<i class="bi bi-people" aria-hidden="true"></i>
				<span class="kanban-action-label"><%= t('kanban:members') %></span>
			</a>
			<a href="/kanban/<%= project.id %>/activity" class="btn btn-outline-secondary btn-sm" data-tooltip-mobile data-bs-title="<%= t('kanban:projectActivity') %>" aria-label="<%= t('kanban:projectActivity') %>">
				<i class="bi bi-clock-history" aria-hidden="true"></i>
				<span class="kanban-action-label"><%= t('kanban:projectActivity') %></span>
			</a>
			<% if (project.role === 'owner') { %>
				<button
					type="button"
					class="btn btn-outline-danger btn-sm"
					data-bs-toggle="modal"
					data-bs-target="#archiveKanbanProjectModal"
					data-project-id="<%= project.id %>"
					data-project-name="<%= project.name %>"
					data-tooltip-mobile
					data-bs-title="<%= t('kanban:deleteProject') %>"
					aria-label="<%= t('kanban:deleteProjectNamed', { name: project.name }) %>"
				>
					<i class="bi bi-trash" aria-hidden="true"></i>
					<span class="kanban-action-label"><%= t('kanban:deleteProject') %></span>
				</button>
			<% } %>
		</div>
	</header>

	<% const stages = ['pending', 'in_progress', 'done']; %>
	<div class="kanban-board" role="group" aria-label="<%= t('kanban:taskBoard') %>" data-kanban-board>
		<% stages.forEach((stage) => { %>
			<% const stageTasks = tasks.filter((task) => task.status === stage); %>
			<section class="kanban-panel kanban-column" aria-labelledby="kanban-stage-<%= stage %>" data-kanban-dropzone data-stage="<%= stage %>">
				<div class="kanban-column-heading">
					<h2 id="kanban-stage-<%= stage %>"><%= t(`kanban:taskStages.${stage}`) %></h2>
					<span class="badge text-bg-secondary"><%= new Intl.NumberFormat(currentLang || 'en').format(stageTasks.length) %></span>
				</div>
				<% if (stageTasks.length === 0) { %>
					<p class="kanban-column-empty"><%= t('kanban:noTasksInStage') %></p>
				<% } else { %>
					<ul class="kanban-task-list">
						<% stageTasks.forEach((task, taskIndex) => { %>
							<li
								class="kanban-task-card"
								data-kanban-task-card
								data-task-id="<%= task.id %>"
								data-task-status="<%= task.status %>"
								<% if (task.canChangeStage) { %>draggable="true"<% } %>
							>
								<div class="kanban-task-card-heading">
									<h3><a href="/kanban/tasks/<%= task.id %>"><%= task.title %></a></h3>
									<% if (task.importance || task.due_date || (task.canChangeStage && stageTasks.length > 1)) { %>
										<div class="kanban-task-card-meta">
											<% if (task.importance) { %>
												<span class="kanban-task-card-importance has-tooltip" role="img" tabindex="0" aria-label="<%= t(`kanban:importanceLevels.${task.importance}`) %>" data-bs-title="<%= t(`kanban:importanceLevels.${task.importance}`) %>">
													<span class="kanban-task-importance-emoji" aria-hidden="true"><%= importanceEmojis[task.importance] %></span>
												</span>
											<% } %>
											<% if (task.due_date) { %>
												<span class="kanban-task-due-icon" data-kanban-due-date="<%= task.due_date %>" role="img" tabindex="0" aria-label="<%= t('kanban:dueDate') %>">
													<span class="kanban-task-due-emoji" aria-hidden="true">📅</span>
												</span>
											<% } %>
											<% if (task.canChangeStage && stageTasks.length > 1) { %>
												<div class="kanban-task-card-order" role="group" aria-label="<%= t('kanban:reorderTask') %>">
													<% if (taskIndex > 0) { %>
														<form method="POST" action="/kanban/tasks/reorder">
															<%- include('../partials/_csrf') %>
															<input type="hidden" name="taskId" value="<%= task.id %>">
															<input type="hidden" name="targetTaskId" value="<%= stageTasks[taskIndex - 1].id %>">
															<input type="hidden" name="placement" value="before">
															<button type="submit" class="btn btn-outline-secondary btn-sm has-tooltip" aria-label="<%= t('kanban:moveTaskUp') %>" data-bs-title="<%= t('kanban:moveTaskUp') %>">
																<i class="bi bi-arrow-up" aria-hidden="true"></i>
															</button>
														</form>
													<% } %>
													<% if (taskIndex < stageTasks.length - 1) { %>
														<form method="POST" action="/kanban/tasks/reorder">
															<%- include('../partials/_csrf') %>
															<input type="hidden" name="taskId" value="<%= task.id %>">
															<input type="hidden" name="targetTaskId" value="<%= stageTasks[taskIndex + 1].id %>">
															<input type="hidden" name="placement" value="after">
															<button type="submit" class="btn btn-outline-secondary btn-sm has-tooltip" aria-label="<%= t('kanban:moveTaskDown') %>" data-bs-title="<%= t('kanban:moveTaskDown') %>">
																<i class="bi bi-arrow-down" aria-hidden="true"></i>
															</button>
														</form>
													<% } %>
												</div>
											<% } %>
										</div>
									<% } %>
								</div>
								<% if (task.canChangeStage) { %>
									<form method="POST" action="/kanban/tasks/stage" hidden data-kanban-stage-form>
										<%- include('../partials/_csrf') %>
										<input type="hidden" name="taskId" value="<%= task.id %>">
										<input type="hidden" name="status" data-kanban-stage-input>
										<input type="hidden" name="returnToBoard" value="true">
									</form>
									<form method="POST" action="/kanban/tasks/reorder" hidden data-kanban-reorder-form>
										<%- include('../partials/_csrf') %>
										<input type="hidden" name="taskId" value="<%= task.id %>">
										<input type="hidden" name="targetTaskId" data-kanban-reorder-target>
										<input type="hidden" name="placement" data-kanban-reorder-placement>
									</form>
								<% } %>
							</li>
						<% }) %>
					</ul>
				<% } %>
			</section>
		<% }) %>
	</div>
</section>

<% if (canCreateTask) { %>
	<%- include('../modals/kanban/_create_task_modal') %>
<% } %>
<% if (project.role === 'owner') { %>
	<%- include('../modals/kanban/_archive_project_modal') %>
<% } %>
