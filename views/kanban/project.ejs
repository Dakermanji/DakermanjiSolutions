<!--! views/kanban/project.ejs -->
<section class="kanban-page" aria-labelledby="project-title">
	<a href="/kanban" class="kanban-back"><%= t('kanban:allProjects') %></a>
	<header class="kanban-header">
		<div>
			<h1 id="project-title"><%= project.name %></h1>
			<% if (project.description) { %>
				<p><%= project.description %></p>
			<% } %>
		</div>
		<div class="kanban-project-actions">
			<span class="badge text-bg-secondary"><%= t(`kanban:roles.${project.role}`) %></span>
			<% if (project.role === 'owner') { %>
				<button
					type="button"
					class="btn btn-outline-danger btn-sm"
					data-bs-toggle="modal"
					data-bs-target="#archiveKanbanProjectModal"
					data-project-id="<%= project.id %>"
					data-project-name="<%= project.name %>"
				>
					<i class="bi bi-trash" aria-hidden="true"></i>
					<%= t('kanban:deleteProject') %>
				</button>
			<% } %>
		</div>
	</header>

	<section class="kanban-panel" aria-labelledby="project-members-title">
		<div class="kanban-section-heading">
			<h2 id="project-members-title"><%= t('kanban:members') %></h2>
			<% if (project.role === 'owner') { %>
				<button
					type="button"
					class="btn btn-action btn-sm"
					data-bs-toggle="modal"
					data-bs-target="#inviteKanbanMemberModal"
				>
					<i class="bi bi-person-plus" aria-hidden="true"></i>
					<%= t('kanban:inviteMember') %>
				</button>
			<% } %>
		</div>
		<ul class="kanban-member-list">
			<% members.forEach((member) => { %>
				<li>
					<span><%= member.username || (project.role === 'owner' ? member.email : t('kanban:member')) %></span>
					<span class="badge text-bg-secondary"><%= t(`kanban:roles.${member.role}`) %></span>
				</li>
			<% }) %>
		</ul>
	</section>
	<% if (project.role === 'owner') { %>
		<section class="kanban-panel mt-4" aria-labelledby="project-invitations-title">
			<h2 id="project-invitations-title"><%= t('kanban:invitationRequests') %></h2>
			<% if (invitations.length === 0) { %>
				<p><%= t('kanban:noInvitationRequests') %></p>
			<% } else { %>
				<ul class="kanban-invitation-list">
					<% invitations.forEach((invitation) => { %>
						<li>
							<div class="kanban-project-row">
								<strong dir="ltr" class="text-break"><%= invitation.requested_identifier %></strong>
								<span class="badge text-bg-secondary"><%= t(`kanban:roles.${invitation.role}`) %></span>
							</div>
							<time datetime="<%= new Date(invitation.expires_at).toISOString() %>">
								<%= t('kanban:invitationExpires', { date: new Intl.DateTimeFormat(currentLang || 'en', { dateStyle: 'medium' }).format(new Date(invitation.expires_at)) }) %>
							</time>
						</li>
					<% }) %>
				</ul>
			<% } %>
		</section>
	<% } %>
</section>

<% if (project.role === 'owner') { %>
	<%- include('../modals/kanban/_archive_project_modal') %>
	<%- include('../modals/kanban/_invite_member_modal') %>
<% } %>
