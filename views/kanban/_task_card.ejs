<!--! views/kanban/_task_card.ejs -->
<li
	class="kanban-task-card"
	data-kanban-task-card
	data-task-id="<%= task.id %>"
	data-task-status="<%= task.status %>"
	data-task-position="<%= task.position %>"
	<% if (task.canChangeStage) { %>draggable="true"<% } %>
>
	<div class="kanban-task-card-heading">
		<h3><a href="/kanban/tasks/<%= task.id %>"><%= task.title %></a></h3>
		<% if (task.importance || task.due_date || task.canChangeStage) { %>
			<div class="kanban-task-card-meta">
				<% if (task.importance) { %>
					<span class="kanban-task-card-importance has-tooltip" role="img" tabindex="0" aria-label="<%= t(`kanban:importanceLevels.${task.importance}`) %>" data-bs-title="<%= t(`kanban:importanceLevels.${task.importance}`) %>">
						<span class="kanban-task-importance-emoji" aria-hidden="true"><%= importanceEmojis[task.importance] %></span>
					</span>
				<% } %>
				<% if (task.due_date) { %>
					<span class="kanban-task-due-icon" data-kanban-due-date="<%= task.due_date %>" role="img" tabindex="0" aria-label="<%= t('kanban:dueDate') %>">
						<span class="kanban-task-due-emoji" aria-hidden="true">📅</span>
					</span>
				<% } %>
				<% if (task.canChangeStage && stageTasks.length > 1) { %>
					<div class="kanban-task-card-order" role="group" aria-label="<%= t('kanban:reorderTask') %>">
						<% if (taskIndex > 0) { %>
							<form method="POST" action="/kanban/tasks/reorder">
								<%- include('../partials/_csrf') %>
								<input type="hidden" name="taskId" value="<%= task.id %>">
								<input type="hidden" name="targetTaskId" value="<%= stageTasks[taskIndex - 1].id %>">
								<input type="hidden" name="placement" value="before">
								<button type="submit" class="btn btn-outline-secondary btn-sm has-tooltip" aria-label="<%= t('kanban:moveTaskUp') %>" data-bs-title="<%= t('kanban:moveTaskUp') %>">
									<i class="bi bi-arrow-up" aria-hidden="true"></i>
								</button>
							</form>
						<% } %>
						<% if (taskIndex < stageTasks.length - 1) { %>
							<form method="POST" action="/kanban/tasks/reorder">
								<%- include('../partials/_csrf') %>
								<input type="hidden" name="taskId" value="<%= task.id %>">
								<input type="hidden" name="targetTaskId" value="<%= stageTasks[taskIndex + 1].id %>">
								<input type="hidden" name="placement" value="after">
								<button type="submit" class="btn btn-outline-secondary btn-sm has-tooltip" aria-label="<%= t('kanban:moveTaskDown') %>" data-bs-title="<%= t('kanban:moveTaskDown') %>">
									<i class="bi bi-arrow-down" aria-hidden="true"></i>
								</button>
							</form>
						<% } %>
					</div>
				<% } %>
				<% if (task.canChangeStage) { %>
					<div class="dropdown kanban-task-stage-menu">
						<button type="button" class="btn btn-outline-secondary btn-sm has-tooltip" data-bs-toggle="dropdown" aria-expanded="false" aria-label="<%= t('kanban:changeTaskStage') %>" data-bs-title="<%= t('kanban:changeTaskStage') %>">
							<i class="bi bi-arrow-left-right" aria-hidden="true"></i>
						</button>
						<ul class="dropdown-menu app-dropdown-surface">
							<% stages.filter((stageOption) => stageOption !== task.status).forEach((stageOption) => { %>
								<li>
									<form method="POST" action="/kanban/tasks/stage">
										<%- include('../partials/_csrf') %>
										<input type="hidden" name="taskId" value="<%= task.id %>">
										<input type="hidden" name="status" value="<%= stageOption %>">
										<input type="hidden" name="returnToBoard" value="true">
										<button type="submit" class="dropdown-item app-dropdown-option"><%= t(`kanban:taskStages.${stageOption}`) %></button>
									</form>
								</li>
							<% }) %>
						</ul>
					</div>
				<% } %>
			</div>
		<% } %>
	</div>
	<% if (task.canChangeStage) { %>
		<form method="POST" action="/kanban/tasks/stage" hidden data-kanban-stage-form>
			<%- include('../partials/_csrf') %>
			<input type="hidden" name="taskId" value="<%= task.id %>">
			<input type="hidden" name="status" data-kanban-stage-input>
			<input type="hidden" name="returnToBoard" value="true">
		</form>
		<form method="POST" action="/kanban/tasks/reorder" hidden data-kanban-reorder-form>
			<%- include('../partials/_csrf') %>
			<input type="hidden" name="taskId" value="<%= task.id %>">
			<input type="hidden" name="targetTaskId" data-kanban-reorder-target>
			<input type="hidden" name="placement" data-kanban-reorder-placement>
		</form>
	<% } %>
</li>
