<!--! views/kanban/taskActivity.ejs -->
<section class="kanban-page" aria-labelledby="task-activity-title" data-kanban-project-id="<%= task.project_id %>" data-kanban-task-id="<%= task.id %>">
	<div class="kanban-context-row">
		<a href="/kanban/tasks/<%= task.id %>" class="kanban-back"><%= t('kanban:backToTask') %></a>
		<span class="badge text-bg-secondary"><%= t(`kanban:roles.${task.viewer_role}`) %></span>
	</div>
	<header class="kanban-header">
		<div>
			<h1 id="task-activity-title"><%= t('kanban:taskActivity') %></h1>
			<p><%= task.title %></p>
		</div>
	</header>

	<%- include('./_task_activity_events', { task, events }) %>
</section>
