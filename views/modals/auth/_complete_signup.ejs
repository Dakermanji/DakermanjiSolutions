<!--! views/modals/auth/_complete_signup.ejs -->

<%
	const isLocal = modal === 'complete_signup_local';
	const action = isLocal ? 'complete-local-signup' : 'set-username';
%>

<div
	class="modal fade"
	id="completeSignUpModal"
	tabindex="-1"
	data-bs-backdrop="static"
	data-bs-keyboard="false"
	aria-labelledby="completeSignUpModalLabel"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">

			<div class="modal-header">
				<h5 class="modal-title" id="completeSignUpModalLabel">
					<%= t('auth:signup.complete_title') %>
				</h5>
			</div>

			<form method="POST" action="/auth/<%= action %>">
				<%- include('../../partials/_csrf') %>
				<div class="modal-body">

					<!-- Username -->
					<div class="mb-3">
						<label for="username" class="form-label">
							<%= t('common:username') %>
						</label>
						<input
							id="username"
							dir="ltr"
							type="text"
							class="form-control"
							name="username"
							required
						/>
					</div>

					<!-- Avatar -->
					<%- include('./_avatar') %>

					<!-- Country -->
					<%- include('./_country') %>

					<% if (isLocal) { %>
						<!-- Set Password -->
						<%- include('./_setPassword', {token}) %>
					<% } %>

					<div class="form-check legal-acceptance">
						<input
							id="legalAcceptance"
							class="form-check-input"
							type="checkbox"
							name="legalAcceptance"
							value="accepted"
							required
						/>
						<label class="form-check-label" for="legalAcceptance">
							<%= t('auth:signup.legalAcceptancePrefix') %>
							<a href="<%= /^\/(?:ar|en|fr)(?:\/|$)/.test(currentUrl.split(/[?#]/)[0]) || currentLang !== 'en' ? `/${currentLang}/legal/terms` : '/legal/terms' %>" target="_blank" rel="noopener noreferrer"><%= t('auth:signup.terms') %></a>
							<%= t('auth:signup.legalAcceptanceConnector') %>
							<a href="<%= /^\/(?:ar|en|fr)(?:\/|$)/.test(currentUrl.split(/[?#]/)[0]) || currentLang !== 'en' ? `/${currentLang}/legal/privacy` : '/legal/privacy' %>" target="_blank" rel="noopener noreferrer"><%= t('auth:signup.privacyPolicy') %></a>.
						</label>
					</div>

				</div>

				<div class="modal-footer">
					<button type="submit" class="btn btn-action w-100">
						<%= t('auth:signup.complete_button') %>
					</button>
				</div>
			</form>

		</div>
	</div>
</div>
