<!--! views/modals/chat/_notes_reset_modal.ejs -->
<div
	class="modal fade"
	id="chatNotesResetModal"
	tabindex="-1"
	aria-labelledby="chatNotesResetModalLabel"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="chatNotesResetModalLabel">
					<%= t('chat:notes.resetTitle') %>
				</h5>
				<button
					type="button"
					class="btn-close"
					data-bs-dismiss="modal"
					aria-label="<%= t('common:close') %>"
				></button>
			</div>

			<form method="POST" action="/chat/notes/reset">
				<%- include('../../partials/_csrf') %>

				<div class="modal-body">
					<p class="mb-0">
						<%= t('chat:notes.resetBody') %>
					</p>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<%= t('common:cancel') %>
					</button>
					<button type="submit" class="btn btn-danger">
						<%= t('chat:notes.resetConfirm') %>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
