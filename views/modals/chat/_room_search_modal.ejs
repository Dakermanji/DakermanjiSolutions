<!--! views/modals/chat/_room_search_modal.ejs -->

<div
	class="modal fade"
	id="chatRoomSearchModal"
	tabindex="-1"
	aria-labelledby="chatRoomSearchModalLabel"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="chatRoomSearchModalLabel">
					<%= t('chat:rooms.searchTitle') %>
				</h5>
				<button
					type="button"
					class="btn-close"
					data-bs-dismiss="modal"
					aria-label="<%= t('common:close') %>"
				></button>
			</div>

			<div class="modal-body">
				<form
					class="chat-room-search-form"
					role="search"
					data-chat-room-search-form
					data-url="/chat/rooms/search"
					data-open-url="/chat/rooms/open"
					data-join-url="/chat/rooms/join"
					data-request-url="/chat/rooms/request"
					data-loading-label="<%= t('chat:states.loading') %>"
					data-empty-label="<%= t('chat:rooms.searchNoResults') %>"
					data-error-label="<%= t('chat:rooms.searchError') %>"
					data-owner-label="<%= t('chat:rooms.owner') %>"
					data-open-label="<%= t('chat:rooms.actions.open') %>"
					data-join-label="<%= t('chat:rooms.actions.join') %>"
					data-request-label="<%= t('chat:rooms.actions.request') %>"
					data-pending-label="<%= t('chat:rooms.actions.pending') %>"
				>
					<label for="chatRoomSearchQuery" class="form-label">
						<%= t('chat:rooms.searchLabel') %>
					</label>
					<div class="input-group">
						<input
							id="chatRoomSearchQuery"
							type="search"
							class="form-control"
							name="query"
							placeholder="<%= t('chat:rooms.searchPlaceholder') %>"
							autocomplete="off"
						/>
						<button class="btn btn-action" type="submit">
							<i class="bi bi-search" aria-hidden="true"></i>
							<span class="visually-hidden">
								<%= t('chat:rooms.searchSubmit') %>
							</span>
						</button>
					</div>
				</form>

				<div class="chat-room-search-results" data-chat-room-search-results>
					<div class="chat-room-search-empty">
						<i class="bi bi-search" aria-hidden="true"></i>
						<p><%= t('chat:rooms.searchEmpty') %></p>
					</div>
				</div>

				<template data-chat-room-search-result-template>
					<div class="chat-room-search-result">
						<span class="chat-room-search-type" data-room-type-icon></span>
						<span class="chat-room-search-content">
							<strong data-room-title></strong>
							<small data-room-description></small>
							<small data-room-owner></small>
						</span>
						<button
							class="btn btn-action-outline chat-room-search-action has-tooltip"
							type="button"
							data-room-action
						></button>
					</div>
				</template>
			</div>
		</div>
	</div>
</div>
