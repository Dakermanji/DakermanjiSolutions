<!--! views/modals/chat/_room_modal.ejs -->
<%
	const safeRoomModalMode =
		typeof roomModalMode !== 'undefined' ? roomModalMode : 'create';
	const safeRoomModalAction =
		typeof roomModalAction !== 'undefined' ? roomModalAction : '/chat/rooms';
	const safeRoomModalValues =
		typeof roomModalValues !== 'undefined' && roomModalValues
			? roomModalValues
			: {};
	const isEditRoomModal = safeRoomModalMode === 'edit';
	const modalTitleKey = isEditRoomModal
		? 'chat:rooms.editTitle'
		: 'chat:rooms.createTitle';
	const modalSubmitKey = isEditRoomModal
		? 'chat:rooms.editSubmit'
		: 'chat:rooms.createSubmit';
	const modalName = safeRoomModalValues.name || safeRoomModalValues.title || '';
	const modalDescription = safeRoomModalValues.description || '';
	const modalKeywords = Array.isArray(safeRoomModalValues.keywords)
		? safeRoomModalValues.keywords.join(', ')
		: safeRoomModalValues.keywords || '';
	const modalVisibility = safeRoomModalValues.visibility || '';
%>

<div
	class="modal fade"
	id="chatRoomModal"
	tabindex="-1"
	aria-labelledby="chatRoomModalLabel"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="chatRoomModalLabel">
					<%= t(modalTitleKey) %>
				</h5>
				<button
					type="button"
					class="btn-close"
					data-bs-dismiss="modal"
					aria-label="<%= t('common:close') %>"
				></button>
			</div>

			<form method="POST" action="<%= safeRoomModalAction %>">
				<%- include('../../partials/_csrf') %>

				<div class="modal-body">
					<div class="mb-3">
						<label for="chatRoomName" class="form-label">
							<%= t('chat:rooms.name') %>
						</label>
						<input
							id="chatRoomName"
							type="text"
							class="form-control"
							name="name"
							required
							maxlength="50"
							autocomplete="off"
							value="<%= modalName %>"
						/>
					</div>

					<div class="mb-3">
						<label for="chatRoomDescription" class="form-label">
							<%= t('chat:rooms.description') %>
						</label>
						<textarea
							id="chatRoomDescription"
							class="form-control"
							name="description"
							rows="4"
							maxlength="500"
						><%= modalDescription %></textarea>
					</div>

					<div class="mb-3">
						<label for="chatRoomKeywords" class="form-label">
							<%= t('chat:rooms.keywords') %>
						</label>
						<input
							id="chatRoomKeywords"
							type="text"
							class="form-control"
							name="keywords"
							required
							maxlength="140"
							autocomplete="off"
							placeholder="<%= t('chat:rooms.keywordsPlaceholder') %>"
							value="<%= modalKeywords %>"
						/>
						<div class="form-text">
							<%= t('chat:rooms.keywordsHelp') %>
						</div>
					</div>

					<fieldset class="mb-0">
						<legend class="form-label">
							<%= t('chat:rooms.visibility') %>
						</legend>

						<div class="vstack gap-2">
							<label class="form-check">
								<input
									class="form-check-input"
									type="radio"
									name="visibility"
									value="<%= roomVisibility.PUBLIC %>"
									data-chat-room-visibility-option="public"
									required
									<% if (modalVisibility === roomVisibility.PUBLIC) { %>checked<% } %>
								/>
								<span class="form-check-label">
									<%= t('chat:rooms.visibilityOptions.public') %>
								</span>
							</label>

							<label class="form-check">
								<input
									class="form-check-input"
									type="radio"
									name="visibility"
									value="<%= roomVisibility.PRIVATE_LISTED %>"
									data-chat-room-visibility-option="private_listed"
									<% if (modalVisibility === roomVisibility.PRIVATE_LISTED) { %>checked<% } %>
								/>
								<span class="form-check-label">
									<%= t('chat:rooms.visibilityOptions.privateListed') %>
								</span>
							</label>

							<label class="form-check">
								<input
									class="form-check-input"
									type="radio"
									name="visibility"
									value="<%= roomVisibility.PRIVATE_UNLISTED %>"
									data-chat-room-visibility-option="private_unlisted"
									<% if (modalVisibility === roomVisibility.PRIVATE_UNLISTED) { %>checked<% } %>
								/>
								<span class="form-check-label">
									<%= t('chat:rooms.visibilityOptions.privateUnlisted') %>
								</span>
							</label>
						</div>
					</fieldset>
				</div>

				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						<%= t('common:cancel') %>
					</button>
					<button type="submit" class="btn btn-action">
						<%= t(modalSubmitKey) %>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
