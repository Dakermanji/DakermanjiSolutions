<!--! views/modals/kanban/_edit_task_modal.ejs -->
<div class="modal fade" id="editKanbanTaskModal" tabindex="-1" aria-labelledby="editKanbanTaskModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="editKanbanTaskModalLabel"><%= t('kanban:editTask') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common:close') %>"></button>
			</div>
			<form method="POST" action="/kanban/tasks/edit">
				<%- include('../../partials/_csrf') %>
				<input type="hidden" name="taskId" value="<%= task.id %>">
				<div class="modal-body">
					<div class="mb-3">
						<label for="edit-task-title" class="form-label"><%= t('kanban:taskTitle') %></label>
						<input id="edit-task-title" name="title" type="text" dir="auto" maxlength="<%= taskLimits.TITLE_MAX_LENGTH %>" value="<%= task.title %>" required class="form-control">
					</div>
					<div class="mb-3">
						<label for="edit-task-description" class="form-label"><%= t('kanban:description') %></label>
						<textarea id="edit-task-description" name="description" dir="auto" maxlength="<%= taskLimits.DESCRIPTION_MAX_LENGTH %>" rows="4" class="form-control"><%= task.description %></textarea>
					</div>
					<div class="mb-3">
						<label for="edit-task-due-date" class="form-label"><%= t('kanban:dueDate') %></label>
						<input id="edit-task-due-date" name="dueDate" type="date" value="<%= task.due_date || '' %>" class="form-control">
					</div>
					<div>
						<label for="edit-task-importance" class="form-label"><%= t('kanban:importance') %></label>
						<select id="edit-task-importance" name="importance" class="form-select" data-app-select>
							<option value="" <%= !task.importance ? 'selected' : '' %>><%= t('kanban:noImportance') %></option>
							<% ['high', 'medium', 'low'].forEach((importance) => { %>
								<option value="<%= importance %>" <%= importance === task.importance ? 'selected' : '' %>><%= t(`kanban:importanceLevels.${importance}`) %></option>
							<% }) %>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common:cancel') %></button>
					<button type="submit" class="btn btn-action"><%= t('kanban:saveTask') %></button>
				</div>
			</form>
		</div>
	</div>
</div>
