<!--! views/modals/kanban/_create_task_modal.ejs -->
<div class="modal fade" id="createKanbanTaskModal" tabindex="-1" aria-labelledby="createKanbanTaskModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="createKanbanTaskModalLabel"><%= t('kanban:createTask') %></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('common:close') %>"></button>
			</div>
			<form method="POST" action="/kanban/tasks">
				<%- include('../../partials/_csrf') %>
				<input type="hidden" name="projectId" value="<%= project.id %>">
				<div class="modal-body">
					<div class="mb-3">
						<label for="task-title" class="form-label"><%= t('kanban:taskTitle') %></label>
						<input id="task-title" name="title" type="text" dir="auto" maxlength="<%= taskLimits.TITLE_MAX_LENGTH %>" required class="form-control">
					</div>
					<div class="mb-3">
						<label for="task-description" class="form-label"><%= t('kanban:description') %></label>
						<textarea id="task-description" name="description" dir="auto" maxlength="<%= taskLimits.DESCRIPTION_MAX_LENGTH %>" rows="4" class="form-control"></textarea>
					</div>
					<div class="mb-3">
						<label for="task-due-date" class="form-label"><%= t('kanban:dueDate') %></label>
						<input id="task-due-date" name="dueDate" type="date" class="form-control">
					</div>
					<div class="mb-3">
						<label for="task-importance" class="form-label"><%= t('kanban:importance') %></label>
						<select id="task-importance" name="importance" class="form-select" data-app-select>
							<option value=""><%= t('kanban:noImportance') %></option>
							<% ['high', 'medium', 'low'].forEach((importance) => { %>
								<option
									value="<%= importance %>"
									data-icon-class="<%= importance === 'high' ? 'bi-chevron-double-up' : importance === 'low' ? 'bi-chevron-double-down' : '' %>"
									data-icon-text="<%= importance === 'medium' ? '=' : '' %>"
								><%= t(`kanban:importanceLevels.${importance}`) %></option>
							<% }) %>
						</select>
					</div>
					<div>
						<label for="task-assignee" class="form-label"><%= t('kanban:assignedTo') %></label>
						<select id="task-assignee" name="assigneeUserId" dir="ltr" class="form-select" data-app-select>
							<option value=""><%= t('kanban:unassigned') %></option>
							<% assignableMembers.forEach((member) => { %>
								<option value="<%= member.user_id %>"><%= member.username || member.email %> (<%= t(`kanban:roles.${member.role}`) %>)</option>
							<% }) %>
						</select>
					</div>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal"><%= t('common:cancel') %></button>
					<button type="submit" class="btn btn-action"><%= t('kanban:createTask') %></button>
				</div>
			</form>
		</div>
	</div>
</div>
