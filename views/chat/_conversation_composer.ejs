<!--! views/chat/_conversation_composer.ejs -->
<div class="chat-typing-indicator" data-chat-typing-indicator hidden>
	<span></span>
</div>

<% if (!canWriteConversation) { %>
	<div class="chat-composer-notice" role="status" data-chat-composer-notice>
		<i class="bi bi-volume-mute-fill" aria-hidden="true"></i>
		<span><%= t('chat:conversation.mutedMessageError') %></span>
	</div>
<% } %>

<form
	class="chat-composer"
	method="POST"
	action="<%= messageFormAction %>"
	aria-label="<%= t('chat:conversation.composer') %>"
	data-chat-composer
>
	<input
		type="hidden"
		name="replyToMessageId"
		value=""
		data-chat-reply-to-message-id
	/>
	<input
		class="form-control"
		type="text"
		name="message"
		maxlength="<%= messageBodyMaxLength %>"
		placeholder="<%= t('chat:conversation.placeholder') %>"
		autocomplete="off"
		required
		<% if (!canWriteConversation) { %>disabled<% } %>
	/>
	<button
		class="btn btn-action-secondary"
		type="submit"
		<% if (!canWriteConversation) { %>disabled<% } %>
	>
		<i class="bi bi-send" aria-hidden="true"></i>
		<span class="visually-hidden"><%= t('chat:conversation.send') %></span>
	</button>
</form>
