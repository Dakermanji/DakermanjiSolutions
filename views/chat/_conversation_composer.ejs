<!--! views/chat/_conversation_composer.ejs -->
<div class="chat-typing-indicator" data-chat-typing-indicator hidden>
	<span></span>
</div>

<% if (!canWriteConversation) { %>
	<div class="chat-composer-notice" role="status" data-chat-composer-notice>
		<i class="bi bi-volume-mute-fill" aria-hidden="true"></i>
		<span><%= t('chat:conversation.mutedMessageError') %></span>
	</div>
<% } %>

<form
	class="chat-composer"
	method="POST"
	action="<%= messageFormAction %>"
	aria-label="<%= t('chat:conversation.composer') %>"
	data-chat-composer
>
	<%- include('../partials/_csrf') %>
	<input type="hidden" name="clientMessageId" value="" />
	<div
		class="chat-composer-reply"
		data-chat-reply-preview
		hidden
	>
		<i class="bi bi-reply" aria-hidden="true"></i>
		<div class="chat-composer-reply-body">
			<strong data-chat-reply-preview-user></strong>
			<span dir="auto" data-chat-reply-preview-text></span>
		</div>
		<button
			class="btn btn-action-outline chat-composer-reply-clear has-tooltip"
			type="button"
			data-chat-reply-clear
			data-bs-title="<%= t('chat:conversation.replyCancel') %>"
			aria-label="<%= t('chat:conversation.replyCancel') %>"
		>
			<i class="bi bi-x-lg" aria-hidden="true"></i>
		</button>
	</div>
	<input
		type="hidden"
		name="replyToMessageId"
		value=""
		data-chat-reply-to-message-id
	/>
	<div
		class="chat-mention-menu"
		id="chat-message-mention-menu"
		data-chat-mention-menu
		role="listbox"
		dir="ltr"
		aria-label="<%= t('chat:conversation.mentionSuggestions') %>"
		hidden
	></div>
	<div
		class="form-control chat-message-editor"
		role="textbox"
		aria-label="<%= t('chat:conversation.composer') %>"
		aria-multiline="true"
		aria-autocomplete="list"
		aria-controls="chat-message-mention-menu"
		aria-expanded="false"
		contenteditable="<%= canWriteConversation ? 'true' : 'false' %>"
		data-placeholder="<%= t('chat:conversation.placeholder') %>"
		data-chat-message-editor
		data-chat-message-input
		data-max-length="<%= messageBodyMaxLength %>"
		dir="<%= currentLang === 'ar' ? 'rtl' : 'ltr' %>"
		<% if (!canWriteConversation) { %>aria-disabled="true"<% } %>
	></div>
	<textarea
		class="visually-hidden"
		name="message"
		data-chat-message-value
		<% if (!canWriteConversation) { %>disabled<% } %>
	></textarea>
	<button
		class="btn btn-action-secondary"
		type="submit"
		<% if (!canWriteConversation) { %>disabled<% } %>
	>
		<i class="bi bi-send" aria-hidden="true"></i>
		<span class="visually-hidden"><%= t('chat:conversation.send') %></span>
	</button>
</form>
