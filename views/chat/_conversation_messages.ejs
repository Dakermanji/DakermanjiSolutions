<!--! views/chat/_conversation_messages.ejs -->
<% let currentMessageDateKey = ''; %>

<div class="chat-message-surface" aria-live="polite" data-chat-message-surface>
	<% if (chatMessages.length > 0) { %>
		<ol class="chat-message-list" data-chat-message-list>
			<% chatMessages.forEach((message) => { %>
				<%
					const messageDateKey = getMessageDateKey(message.createdAt);
					const shouldShowDateSeparator =
						messageDateKey && messageDateKey !== currentMessageDateKey;
					currentMessageDateKey = messageDateKey || currentMessageDateKey;
				%>
				<% if (shouldShowDateSeparator) { %>
					<li class="chat-date-separator" data-chat-date-separator>
						<time datetime="<%= messageDateKey %>">
							-- <%= formatMessageDate(message.createdAt) %> --
						</time>
					</li>
				<% } %>
				<%- include('_conversation_message_row', {
					deleteMessageUrl,
					extraReactions,
					formatMessageTime,
					getReplySenderName,
					getSenderName,
					isRoomConversation,
					message,
					quickReactions,
					reactionMessageUrl,
					t,
				}) %>
			<% }) %>
		</ol>
	<% } else { %>
		<div class="chat-empty-state" data-chat-empty-state>
			<i class="bi bi-chat-dots" aria-hidden="true"></i>
			<p><%= t('chat:conversation.empty') %></p>
		</div>
	<% } %>
</div>