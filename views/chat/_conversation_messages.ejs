<!--! views/chat/_conversation_messages.ejs -->
<% let currentMessageDateKey = ''; %>

<div class="chat-message-surface" aria-live="polite" data-chat-message-surface>
	<% if (chatMessages.length > 0) { %>
		<ol class="chat-message-list" data-chat-message-list>
			<% chatMessages.forEach((message) => { %>
				<%
					const messageDateKey = getMessageDateKey(message.createdAt);
					const shouldShowDateSeparator =
						messageDateKey && messageDateKey !== currentMessageDateKey;
					currentMessageDateKey = messageDateKey || currentMessageDateKey;
				%>
				<% if (shouldShowDateSeparator) { %>
					<li class="chat-date-separator" data-chat-date-separator>
						<time datetime="<%= messageDateKey %>">
							-- <%= formatMessageDate(message.createdAt) %> --
						</time>
					</li>
				<% } %>
				<li
					class="chat-message-row <%= message.isMine ? 'is-mine' : 'is-theirs' %>"
					data-chat-message-id="<%= message.id %>"
					data-chat-message-sender-id="<%= message.sender?.id || '' %>"
					data-chat-message-sender-name="<%= getSenderName(message) %>"
					data-chat-message-sender-avatar="<%= message.sender?.avatar?.src || '' %>"
					data-chat-message-sender-avatar-bg="<%= message.sender?.avatar?.background || '' %>"
					data-chat-message-created-at="<%= new Date(message.createdAt).toISOString() %>"
					data-chat-message-pending-flag-count="<%= message.pendingFlagCount || 0 %>"
					data-chat-message-flagged-by-viewer="<%= message.flaggedByViewer ? 'true' : 'false' %>"
					data-chat-message-can-edit="<%= message.canEdit ? 'true' : 'false' %>"
					data-chat-message-can-delete="<%= message.canDelete ? 'true' : 'false' %>"
					data-chat-message-edited="<%= message.editedAt ? 'true' : 'false' %>"
				>
					<% if (!message.isMine) { %>
						<div class="chat-message-sender-stack">
							<% if (isRoomConversation) { %>
								<span
									class="chat-message-sender-avatar"
									style="background-color: <%= message.sender?.avatar?.background || '' %>;"
									aria-hidden="true"
								>
									<% if (message.sender?.avatar?.src) { %>
										<img src="<%= message.sender.avatar.src %>" alt="" />
									<% } else { %>
										<%= getSenderName(message).slice(0, 1).toUpperCase() %>
									<% } %>
								</span>
							<% } %>
							<button
								class="btn btn-action-outline chat-message-action chat-message-reply-side has-tooltip"
								type="button"
								data-chat-message-reply
								data-bs-title="<%= t('chat:conversation.reply') %>"
								aria-label="<%= t('chat:conversation.reply') %>"
							>
								<i class="bi bi-reply" aria-hidden="true"></i>
							</button>
						</div>
					<% } %>
					<div class="chat-message-content">
						<article class="chat-message-bubble">
							<% if (isRoomConversation && !message.isMine) { %>
								<header class="chat-message-sender-name">
									<%= getSenderName(message) %>
								</header>
							<% } %>
							<% if (message.replyTo) { %>
								<blockquote
									class="chat-message-reply"
									dir="auto"
									data-chat-message-reply-id="<%= message.replyTo.id %>"
								>
									<strong><%= getReplySenderName(message) %></strong>
									<span>
										<%= message.replyTo.isDeleted
											? t('chat:conversation.replyDeleted')
											: message.replyTo.bodyPreview %>
									</span>
								</blockquote>
							<% } %>
							<p class="chat-message-text" dir="auto"><%= message.body %></p>
						</article>
						<% if (message.reactions?.some((reaction) => reaction.count > 0)) { %>
							<div class="chat-message-reaction-summary" data-chat-message-reaction-summary>
								<% message.reactions.filter((reaction) => reaction.count > 0).forEach((reaction) => { %>
									<span
										class="chat-message-reaction-summary-item <%= reaction.reactedByViewer ? 'is-active' : '' %>"
										data-chat-message-reaction-summary-item
										data-message-id="<%= message.id %>"
										data-reaction="<%= reaction.reaction %>"
										data-reaction-label="<%= reaction.label %>"
										aria-label="<%= `${reaction.label}: ${reaction.count}` %>"
										aria-pressed="<%= reaction.reactedByViewer ? 'true' : 'false' %>"
										role="button"
										tabindex="0"
									>
										<span aria-hidden="true"><%= reaction.reaction %></span>
										<span><%= reaction.count %></span>
									</span>
								<% }) %>
							</div>
						<% } %>
					</div>
					<div class="chat-message-meta">
						<% if (message.editedAt) { %>
							<span class="chat-message-edited">
								<span><%= t('chat:conversation.edited') %></span>
								<time datetime="<%= new Date(message.editedAt).toISOString() %>">
									<%= formatMessageTime(message.editedAt) %>
								</time>
							</span>
						<% } %>
						<div class="chat-message-time-actions">
							<% if (quickReactions?.length > 0) { %>
								<span class="chat-message-reaction-picker" data-chat-message-reactions>
									<button
										class="btn btn-action-outline chat-message-action chat-message-reaction-toggle"
										type="button"
										data-chat-message-reaction-toggle
										aria-label="React"
										aria-expanded="false"
									>
										<i class="bi bi-emoji-smile" aria-hidden="true"></i>
										<i class="bi bi-plus chat-message-reaction-plus" aria-hidden="true"></i>
									</button>
									<span class="chat-message-reaction-menu" data-chat-message-reaction-menu hidden>
										<span class="chat-message-reaction-search" data-chat-message-reaction-search hidden>
											<i class="bi bi-search" aria-hidden="true"></i>
											<input
												type="search"
												data-chat-message-reaction-search-input
												aria-label="Search reactions"
												placeholder="Search..."
											/>
										</span>
										<span class="chat-message-reaction-group">
											<% quickReactions.forEach((quickReaction) => { %>
												<%
													const currentReaction = message.reactions?.find(
														(item) => item.reaction === quickReaction.reaction,
													);
													const reactionCount = currentReaction?.count || 0;
													const reactedByViewer = Boolean(currentReaction?.reactedByViewer);
													const reactionSearch = [
														quickReaction.reaction,
														quickReaction.label,
														...(quickReaction.keywords || []),
													].join(' ');
												%>
												<form
													class="chat-message-reaction-form"
													method="POST"
													action="<%= reactionMessageUrl %>"
													data-chat-message-reaction-form
													data-chat-message-reaction-search-text="<%= reactionSearch %>"
												>
													<%- include('../partials/_csrf') %>
													<input type="hidden" name="messageId" value="<%= message.id %>" />
													<input type="hidden" name="reaction" value="<%= quickReaction.reaction %>" />
													<button
														class="chat-message-reaction has-tooltip has-title <%= reactedByViewer ? 'is-active' : '' %>"
														type="submit"
														data-bs-title="<%= quickReaction.label %>"
														aria-label="<%= `${quickReaction.label}: ${reactionCount}` %>"
													>
														<span aria-hidden="true"><%= quickReaction.reaction %></span>
													</button>
												</form>
											<% }) %>
											<% if (extraReactions?.length > 0) { %>
												<button
													class="chat-message-reaction chat-message-reaction-search-toggle"
													type="button"
													data-chat-message-reaction-search-toggle
													aria-label="Search reactions"
													aria-expanded="false"
												>
													<i class="bi bi-search" aria-hidden="true"></i>
												</button>
												<button
													class="chat-message-reaction chat-message-reaction-more"
													type="button"
													data-chat-message-reaction-more
													aria-label="More reactions"
													aria-expanded="false"
												>
													<i class="bi bi-plus-lg" aria-hidden="true"></i>
												</button>
											<% } %>
										</span>
										<% if (extraReactions?.length > 0) { %>
											<span class="chat-message-reaction-group is-extra" data-chat-message-reaction-extra hidden>
												<% extraReactions.forEach((extraReaction) => { %>
													<%
													const currentReaction = message.reactions?.find(
														(item) => item.reaction === extraReaction.reaction,
													);
													const reactionCount = currentReaction?.count || 0;
													const reactedByViewer = Boolean(currentReaction?.reactedByViewer);
													const reactionSearch = [
														extraReaction.reaction,
														extraReaction.label,
														...(extraReaction.keywords || []),
													].join(' ');
												%>
												<form
													class="chat-message-reaction-form"
													method="POST"
													action="<%= reactionMessageUrl %>"
													data-chat-message-reaction-form
													data-chat-message-reaction-search-text="<%= reactionSearch %>"
												>
														<%- include('../partials/_csrf') %>
														<input type="hidden" name="messageId" value="<%= message.id %>" />
														<input type="hidden" name="reaction" value="<%= extraReaction.reaction %>" />
														<button
															class="chat-message-reaction has-tooltip has-title <%= reactedByViewer ? 'is-active' : '' %>"
															type="submit"
															data-bs-title="<%= extraReaction.label %>"
															aria-label="<%= `${extraReaction.label}: ${reactionCount}` %>"
														>
															<span aria-hidden="true"><%= extraReaction.reaction %></span>
														</button>
													</form>
												<% }) %>
											</span>
										<% } %>
									</span>
								</span>
							<% } %>
							<time
								class="chat-message-time"
								datetime="<%= new Date(message.createdAt).toISOString() %>"
							>
								<%= formatMessageTime(message.createdAt) %>
							</time>
							<% if (message.isMine) { %>
								<button
									class="btn btn-action-outline chat-message-action chat-message-reply-inline has-tooltip"
									type="button"
									data-chat-message-reply
									data-bs-title="<%= t('chat:conversation.reply') %>"
									aria-label="<%= t('chat:conversation.reply') %>"
								>
									<i class="bi bi-reply" aria-hidden="true"></i>
								</button>
							<% } %>
						</div>
					</div>
					<% if (message.isMine && (message.canEdit || message.canDelete)) { %>
						<div class="chat-message-actions">
							<% if (message.isMine && message.canEdit) { %>
								<button
									class="btn btn-action-outline chat-message-action has-tooltip"
									type="button"
									data-chat-message-edit
									data-bs-title="<%= t('chat:conversation.edit') %>"
									aria-label="<%= t('chat:conversation.edit') %>"
								>
									<i class="bi bi-pencil" aria-hidden="true"></i>
								</button>
							<% } %>
							<% if (message.isMine && message.canDelete) { %>
								<form
									class="chat-message-delete-form"
									method="POST"
									action="<%= deleteMessageUrl %>"
									data-chat-message-delete-form
								>
									<%- include('../partials/_csrf') %>
									<input type="hidden" name="messageId" value="<%= message.id %>" />
									<button
										class="btn btn-action-outline chat-message-action is-danger has-tooltip"
										type="submit"
										data-bs-title="<%= t('chat:conversation.delete') %>"
										aria-label="<%= t('chat:conversation.delete') %>"
									>
										<i class="bi bi-trash3" aria-hidden="true"></i>
									</button>
								</form>
							<% } %>
						</div>
					<% } %>
					<% if (isRoomConversation && !message.isMine) { %>
						<form
							class="chat-message-flag-form"
							method="POST"
							action="/chat/rooms/messages/flag"
						>
							<%- include('../partials/_csrf') %>
							<input type="hidden" name="messageId" value="<%= message.id %>" />
							<button
								class="btn btn-action-outline chat-message-flag-button has-tooltip <%= message.flaggedByViewer ? 'is-flagged' : '' %>"
								type="submit"
								data-bs-title="<%= t(message.flaggedByViewer ? 'chat:conversation.flagged' : 'chat:conversation.flag') %>"
								aria-label="<%= t(message.flaggedByViewer ? 'chat:conversation.flagged' : 'chat:conversation.flag') %>"
								<% if (message.flaggedByViewer) { %>disabled<% } %>
							>
								<i class="bi <%= message.flaggedByViewer ? 'bi-flag-fill' : 'bi-flag' %>" aria-hidden="true"></i>
							</button>
						</form>
					<% } %>
				</li>
			<% }) %>
		</ol>
	<% } else { %>
		<div class="chat-empty-state" data-chat-empty-state>
			<i class="bi bi-chat-dots" aria-hidden="true"></i>
			<p><%= t('chat:conversation.empty') %></p>
		</div>
	<% } %>
</div>
