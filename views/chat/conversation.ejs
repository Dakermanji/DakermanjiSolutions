<!--! views/chat/conversation.ejs -->
<%
	const friend = activeConversation.friend || {};
	const conversation = activeConversation.conversation || {};
	const friendName =
		friend.username ||
		friend.email ||
		t('chat:friendFallback');
	const chatMessages = Array.isArray(messages) ? messages : [];
	const canLoadOlderMessages = Boolean(hasOlderMessages);
	const formatMessageTime = (value) => {
		if (!value) return '';

		return new Intl.DateTimeFormat(currentLang || 'en', {
			hour: '2-digit',
			minute: '2-digit',
		}).format(new Date(value));
	};
%>

<section
	class="chat-page chat-conversation-page"
	aria-labelledby="chat-conversation-title"
	data-active-conversation-id="<%= conversation.id %>"
	data-current-user-id="<%= user.id %>"
	data-typing-label="<%= t('chat:conversation.typing', { user: friendName }) %>"
	data-has-older-messages="<%= canLoadOlderMessages ? 'true' : 'false' %>"
	data-older-messages-url="/chat/messages"
>
	<header class="chat-conversation-header">
		<form method="POST" action="/chat/close" class="chat-back-form">
			<button
				class="btn btn-action-outline chat-back-button has-tooltip"
				type="submit"
				data-bs-title="<%= t('chat:backToChats') %>"
				aria-label="<%= t('chat:backToChats') %>"
			>
				<i class="bi bi-arrow-left" aria-hidden="true"></i>
			</button>
		</form>

		<span
			class="chat-conversation-avatar"
			style="background-color: <%= friend.avatar?.background || '' %>;"
			aria-hidden="true"
		>
			<% if (friend.avatar?.src) { %>
				<img src="<%= friend.avatar.src %>" alt="" />
			<% } else { %>
				<%= friendName.slice(0, 1).toUpperCase() %>
			<% } %>
		</span>

		<div class="chat-conversation-title">
			<p class="chat-kicker"><%= t('chat:sections.friends.title') %></p>
			<h1 id="chat-conversation-title"><%= friendName %></h1>
		</div>
	</header>

	<div class="chat-message-surface" aria-live="polite" data-chat-message-surface>
		<% if (chatMessages.length > 0) { %>
			<ol class="chat-message-list" data-chat-message-list>
				<% chatMessages.forEach((message) => { %>
					<li
						class="chat-message-row <%= message.isMine ? 'is-mine' : 'is-theirs' %>"
						data-chat-message-id="<%= message.id %>"
						data-chat-message-created-at="<%= new Date(message.createdAt).toISOString() %>"
					>
						<article class="chat-message-bubble">
							<p><%= message.body %></p>
							<footer>
								<time datetime="<%= new Date(message.createdAt).toISOString() %>">
									<%= formatMessageTime(message.createdAt) %>
								</time>
							</footer>
						</article>
					</li>
				<% }) %>
			</ol>
		<% } else { %>
			<div class="chat-empty-state" data-chat-empty-state>
				<i class="bi bi-chat-dots" aria-hidden="true"></i>
				<p><%= t('chat:conversation.empty') %></p>
			</div>
		<% } %>
	</div>

	<div class="chat-typing-indicator" data-chat-typing-indicator hidden>
		<span></span>
	</div>

	<form
		class="chat-composer"
		method="POST"
		action="/chat/messages"
		aria-label="<%= t('chat:conversation.composer') %>"
		data-chat-composer
	>
		<input
			class="form-control"
			type="text"
			name="message"
			maxlength="2000"
			placeholder="<%= t('chat:conversation.placeholder') %>"
			autocomplete="off"
			required
		/>
		<button
			class="btn btn-action-secondary"
			type="submit"
		>
			<i class="bi bi-send" aria-hidden="true"></i>
			<span class="visually-hidden"><%= t('chat:conversation.send') %></span>
		</button>
	</form>
</section>
