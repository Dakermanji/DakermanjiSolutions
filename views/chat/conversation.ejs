<!--! views/chat/conversation.ejs -->
<%
	const friend = activeConversation.friend || {};
	const room = activeConversation.room || {};
	const conversation = activeConversation.conversation || {};
	const isRoomConversation = activeConversation.kind === 'room' || Boolean(room.id);
	const safeRoomMembers =
		typeof roomMembers !== 'undefined' && Array.isArray(roomMembers)
			? roomMembers
			: [];
	const safeRoomManagementMembers =
		typeof roomManagementMembers !== 'undefined' && Array.isArray(roomManagementMembers)
			? roomManagementMembers
			: [];
	const roomMemberList = isRoomConversation ? safeRoomMembers : [];
	const roomManagementMemberList = isRoomConversation
		? safeRoomManagementMembers
		: [];
	const canManageRoom =
		isRoomConversation &&
		room.memberStatus === 'active' &&
		['owner', 'admin'].includes(room.memberRole);
	const isRoomOwner = room.memberRole === 'owner';
	const friendName =
		friend.username ||
		friend.email ||
		t('chat:friendFallback');
	const roomName = room.title || t('chat:createRoom');
	const conversationName = isRoomConversation ? roomName : friendName;
	const conversationKicker = isRoomConversation
		? t(
			room.visibility === 'public'
				? 'chat:sections.publicRooms.title'
				: 'chat:sections.privateRooms.title',
		)
		: t('chat:sections.friends.title');
	const chatMessages = Array.isArray(messages) ? messages : [];
	const canLoadOlderMessages = Boolean(hasOlderMessages);
	const olderMessagesUrl = isRoomConversation
		? '/chat/rooms/messages'
		: '/chat/friends/messages';
	const editMessageUrl = isRoomConversation
		? '/chat/rooms/messages/edit'
		: '/chat/friends/messages/edit';
	const deleteMessageUrl = isRoomConversation
		? '/chat/rooms/messages/delete'
		: '/chat/friends/messages/delete';
	const messageFormAction = isRoomConversation
		? '/chat/rooms/messages'
		: '/chat/friends/messages';
	const canWriteConversation = !isRoomConversation || room.canWrite !== false;
	const getMemberName = (member) =>
		member.displayName ||
		member.username ||
		member.email ||
		t('chat:friendFallback');
	const getManagementGroupKey = (member) => {
		if (member.status === 'banned') return 'banned';
		if (member.status === 'muted') return 'muted';
		if (member.role === 'owner') return 'owners';
		if (member.role === 'admin') return 'admins';
		return 'members';
	};
	const canManageTarget = (member) =>
		canManageRoom &&
		member.id !== user.id &&
		member.role !== 'owner' &&
		(isRoomOwner || member.role === 'member');
	const canPromoteTarget = (member) =>
		isRoomOwner &&
		member.role === 'member' &&
		['active', 'muted'].includes(member.status);
	const canDemoteTarget = (member) =>
		isRoomOwner &&
		member.role === 'admin' &&
		['active', 'muted'].includes(member.status);
	const canRemoveTarget = (member) =>
		canManageTarget(member) &&
		['active', 'muted'].includes(member.status);
	const canMuteTarget = (member) =>
		canManageTarget(member) &&
		member.status === 'active';
	const canUnmuteTarget = (member) =>
		canManageTarget(member) &&
		member.status === 'muted';
	const canBanTarget = (member) =>
		canManageTarget(member) &&
		['active', 'muted'].includes(member.status);
	const canUnbanTarget = (member) =>
		canManageTarget(member) &&
		member.status === 'banned';
	const canDeleteTarget = (member) =>
		isRoomOwner &&
		member.id !== user.id &&
		member.role !== 'owner';
	const managementGroups = [
		{ key: 'owners', members: roomManagementMemberList.filter((member) => getManagementGroupKey(member) === 'owners') },
		{ key: 'admins', members: roomManagementMemberList.filter((member) => getManagementGroupKey(member) === 'admins') },
		{ key: 'members', members: roomManagementMemberList.filter((member) => getManagementGroupKey(member) === 'members') },
		{ key: 'muted', members: roomManagementMemberList.filter((member) => getManagementGroupKey(member) === 'muted') },
		{ key: 'banned', members: roomManagementMemberList.filter((member) => getManagementGroupKey(member) === 'banned') },
	].filter((group) => group.members.length > 0);
	const getSenderName = (message) =>
		message.sender?.displayName ||
		message.sender?.username ||
		message.sender?.email ||
		t('chat:friendFallback');
	const formatMessageTime = (value) => {
		if (!value) return '';

		return new Intl.DateTimeFormat(currentLang || 'en', {
			hour: '2-digit',
			minute: '2-digit',
		}).format(new Date(value));
	};
	const formatMessageDate = (value) => {
		if (!value) return '';

		return new Intl.DateTimeFormat(currentLang || 'en', {
			day: 'numeric',
			month: 'long',
			year: 'numeric',
		}).format(new Date(value));
	};
	const getMessageDateKey = (value) => {
		if (!value) return '';

		const date = new Date(value);
		if (Number.isNaN(date.getTime())) return '';

		const year = date.getFullYear();
		const month = String(date.getMonth() + 1).padStart(2, '0');
		const day = String(date.getDate()).padStart(2, '0');

		return `${year}-${month}-${day}`;
	};
	const flagCountLabels = isRoomConversation
		? t('chat:flags.flagCount', { returnObjects: true })
		: {};
	const formatFlagCountLabel = (count) => {
		const labels =
			flagCountLabels &&
			typeof flagCountLabels === 'object' &&
			!Array.isArray(flagCountLabels)
				? flagCountLabels
				: { other: String(flagCountLabels || '{{count}}') };
		const category = new Intl.PluralRules(currentLang || 'en').select(count);
		const template = labels[category] || labels.other || labels.one || '{{count}}';

		return template.replace('{{count}}', String(count));
	};
	let currentMessageDateKey = '';
%>

<section
	class="chat-page chat-conversation-page"
	aria-labelledby="chat-conversation-title"
	data-active-conversation-id="<%= conversation.id %>"
	data-current-user-id="<%= user.id %>"
	data-chat-conversation-kind="<%= isRoomConversation ? 'room' : 'friend' %>"
	data-typing-label="✍️ <%= t('chat:conversation.typing', { user: conversationName }) %>"
	data-has-older-messages="<%= canLoadOlderMessages ? 'true' : 'false' %>"
	data-older-messages-url="<%= olderMessagesUrl %>"
	data-message-mutation-window-ms="<%= messageMutationWindowMs || 0 %>"
	data-edit-message-url="<%= editMessageUrl %>"
	data-delete-message-url="<%= deleteMessageUrl %>"
	data-edit-message-label="<%= t('chat:conversation.edit') %>"
	data-delete-message-label="<%= t('chat:conversation.delete') %>"
	data-edit-message-prompt="<%= t('chat:conversation.editPrompt') %>"
	data-delete-message-confirm="<%= t('chat:conversation.deleteConfirm') %>"
	data-message-edited-label="<%= t('chat:conversation.edited') %>"
	data-flag-message-url="/chat/rooms/messages/flag"
	data-flag-message-label="<%= t('chat:conversation.flag') %>"
	data-message-flagged-label="<%= t('chat:conversation.flagged') %>"
	data-flags-url="/chat/rooms/flags"
	data-flags-safe-url="/chat/rooms/flags/safe"
	data-flags-delete-url="/chat/rooms/flags/delete"
	data-flags-loading-label="<%= t('chat:flags.loading') %>"
	data-flags-error-label="<%= t('chat:flags.error') %>"
	data-flags-empty-label="<%= t('chat:flags.empty') %>"
	data-flags-open-context-label="<%= t('chat:flags.actions.openContext') %>"
	data-flags-safe-label="<%= t('chat:flags.actions.safe') %>"
	data-flags-delete-label="<%= t('chat:flags.actions.delete') %>"
	data-flags-context-missing-label="<%= t('chat:flags.contextMissing') %>"
	data-flags-delete-confirm="<%= t('chat:flags.deleteConfirm') %>"
	data-activity-url="/chat/rooms/activity"
	data-activity-loading-label="<%= t('chat:activity.loading') %>"
	data-activity-error-label="<%= t('chat:activity.error') %>"
	data-activity-empty-label="<%= t('chat:activity.empty') %>"
	data-activity-load-more-label="<%= t('chat:activity.loadMore') %>"
	data-activity-system-label="<%= t('chat:activity.system') %>"
	data-activity-field-label-name="<%= t('chat:rooms.name') %>"
	data-activity-field-label-description="<%= t('chat:rooms.description') %>"
	data-activity-field-label-keywords="<%= t('chat:rooms.keywords') %>"
	data-activity-field-label-visibility="<%= t('chat:rooms.visibility') %>"
>
	<header class="chat-conversation-header">
		<form method="POST" action="/chat/friends/close" class="chat-back-form">
			<button
				class="btn btn-action-outline chat-back-button has-tooltip"
				type="submit"
				data-bs-title="<%= t('chat:backToChats') %>"
				aria-label="<%= t('chat:backToChats') %>"
			>
				<i class="bi bi-arrow-left" aria-hidden="true"></i>
			</button>
		</form>

		<span
			class="chat-conversation-avatar"
			style="background-color: <%= isRoomConversation ? '' : (friend.avatar?.background || '') %>;"
			aria-hidden="true"
		>
			<% if (!isRoomConversation && friend.avatar?.src) { %>
				<img src="<%= friend.avatar.src %>" alt="" />
			<% } else { %>
				<%= conversationName.slice(0, 1).toUpperCase() %>
			<% } %>
		</span>

		<div class="chat-conversation-title">
			<p class="chat-kicker"><%= conversationKicker %></p>
			<h1 id="chat-conversation-title" dir="auto"><%= conversationName %></h1>
		</div>

		<% if (isRoomConversation) { %>
			<div class="chat-conversation-actions">
				<% if (isRoomOwner) { %>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-bs-toggle="modal"
						data-bs-target="#chatRoomModal"
						data-bs-title="<%= t('chat:rooms.infoToggle') %>"
						aria-label="<%= t('chat:rooms.infoToggle') %>"
					>
						<i class="bi bi-info-circle-fill" aria-hidden="true"></i>
					</button>
				<% } %>
				<% if (canManageRoom) { %>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-chat-flags-toggle
						data-bs-title="<%= t('chat:flags.toggle') %>"
						aria-label="<%= t('chat:flags.toggle') %>"
						aria-controls="chat-flags-panel"
						aria-expanded="false"
					>
						<i class="bi bi-flag-fill" aria-hidden="true"></i>
					</button>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-chat-activity-toggle
						data-bs-title="<%= t('chat:activity.toggle') %>"
						aria-label="<%= t('chat:activity.toggle') %>"
						aria-controls="chat-activity-panel"
						aria-expanded="false"
					>
						<i class="bi bi-clock-history" aria-hidden="true"></i>
					</button>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-chat-management-toggle
						data-bs-title="<%= t('chat:members.manageToggle') %>"
						aria-label="<%= t('chat:members.manageToggle') %>"
						aria-controls="chat-management-panel"
						aria-expanded="false"
					>
						<i class="bi bi-gear-fill" aria-hidden="true"></i>
					</button>
				<% } %>
				<button
					class="btn btn-action-outline chat-panel-toggle has-tooltip"
					type="button"
					data-chat-members-toggle
					data-bs-title="<%= t('chat:members.toggle') %>"
					aria-label="<%= t('chat:members.toggle') %>"
					aria-controls="chat-members-panel"
					aria-expanded="false"
				>
					<i class="bi bi-people-fill" aria-hidden="true"></i>
				</button>
			</div>
		<% } %>
	</header>

	<div class="chat-message-surface" aria-live="polite" data-chat-message-surface>
		<% if (chatMessages.length > 0) { %>
			<ol class="chat-message-list" data-chat-message-list>
				<% chatMessages.forEach((message) => { %>
					<%
						const messageDateKey = getMessageDateKey(message.createdAt);
						const shouldShowDateSeparator =
							messageDateKey && messageDateKey !== currentMessageDateKey;
						currentMessageDateKey = messageDateKey || currentMessageDateKey;
					%>
					<% if (shouldShowDateSeparator) { %>
						<li class="chat-date-separator" data-chat-date-separator>
							<time datetime="<%= messageDateKey %>">
								-- <%= formatMessageDate(message.createdAt) %> --
							</time>
						</li>
					<% } %>
					<li
						class="chat-message-row <%= message.isMine ? 'is-mine' : 'is-theirs' %>"
						data-chat-message-id="<%= message.id %>"
						data-chat-message-sender-id="<%= message.sender?.id || '' %>"
						data-chat-message-sender-name="<%= getSenderName(message) %>"
						data-chat-message-sender-avatar="<%= message.sender?.avatar?.src || '' %>"
						data-chat-message-sender-avatar-bg="<%= message.sender?.avatar?.background || '' %>"
						data-chat-message-created-at="<%= new Date(message.createdAt).toISOString() %>"
						data-chat-message-pending-flag-count="<%= message.pendingFlagCount || 0 %>"
						data-chat-message-flagged-by-viewer="<%= message.flaggedByViewer ? 'true' : 'false' %>"
						data-chat-message-can-edit="<%= message.canEdit ? 'true' : 'false' %>"
						data-chat-message-can-delete="<%= message.canDelete ? 'true' : 'false' %>"
						data-chat-message-edited="<%= message.editedAt ? 'true' : 'false' %>"
					>
						<% if (isRoomConversation && !message.isMine) { %>
							<span
								class="chat-message-sender-avatar"
								style="background-color: <%= message.sender?.avatar?.background || '' %>;"
								aria-hidden="true"
							>
								<% if (message.sender?.avatar?.src) { %>
									<img src="<%= message.sender.avatar.src %>" alt="" />
								<% } else { %>
									<%= getSenderName(message).slice(0, 1).toUpperCase() %>
								<% } %>
							</span>
						<% } %>
						<article class="chat-message-bubble">
							<% if (isRoomConversation && !message.isMine) { %>
								<header class="chat-message-sender-name">
									<%= getSenderName(message) %>
								</header>
							<% } %>
							<p class="chat-message-text" dir="auto"><%= message.body %></p>
						</article>
						<span class="chat-message-meta">
							<% if (message.editedAt) { %>
								<span class="chat-message-edited">
									<span><%= t('chat:conversation.edited') %></span>
									<time datetime="<%= new Date(message.editedAt).toISOString() %>">
										<%= formatMessageTime(message.editedAt) %>
									</time>
								</span>
							<% } %>
							<time
								class="chat-message-time"
								datetime="<%= new Date(message.createdAt).toISOString() %>"
							>
								<%= formatMessageTime(message.createdAt) %>
							</time>
						</span>
						<% if (message.isMine && (message.canEdit || message.canDelete)) { %>
							<div class="chat-message-actions">
								<% if (message.canEdit) { %>
									<button
										class="btn btn-action-outline chat-message-action has-tooltip"
										type="button"
										data-chat-message-edit
										data-bs-title="<%= t('chat:conversation.edit') %>"
										aria-label="<%= t('chat:conversation.edit') %>"
									>
										<i class="bi bi-pencil" aria-hidden="true"></i>
									</button>
								<% } %>
								<% if (message.canDelete) { %>
									<form
										class="chat-message-delete-form"
										method="POST"
										action="<%= deleteMessageUrl %>"
										data-chat-message-delete-form
									>
										<%- include('../partials/_csrf') %>
										<input type="hidden" name="messageId" value="<%= message.id %>" />
										<button
											class="btn btn-action-outline chat-message-action is-danger has-tooltip"
											type="submit"
											data-bs-title="<%= t('chat:conversation.delete') %>"
											aria-label="<%= t('chat:conversation.delete') %>"
										>
											<i class="bi bi-trash3" aria-hidden="true"></i>
										</button>
									</form>
								<% } %>
							</div>
						<% } %>
						<% if (isRoomConversation && !message.isMine) { %>
							<form
								class="chat-message-flag-form"
								method="POST"
								action="/chat/rooms/messages/flag"
							>
								<%- include('../partials/_csrf') %>
								<input type="hidden" name="messageId" value="<%= message.id %>" />
								<button
									class="btn btn-action-outline chat-message-flag-button has-tooltip <%= message.flaggedByViewer ? 'is-flagged' : '' %>"
									type="submit"
									data-bs-title="<%= t(message.flaggedByViewer ? 'chat:conversation.flagged' : 'chat:conversation.flag') %>"
									aria-label="<%= t(message.flaggedByViewer ? 'chat:conversation.flagged' : 'chat:conversation.flag') %>"
									<% if (message.flaggedByViewer) { %>disabled<% } %>
								>
									<i class="bi <%= message.flaggedByViewer ? 'bi-flag-fill' : 'bi-flag' %>" aria-hidden="true"></i>
								</button>
							</form>
						<% } %>
					</li>
				<% }) %>
			</ol>
		<% } else { %>
			<div class="chat-empty-state" data-chat-empty-state>
				<i class="bi bi-chat-dots" aria-hidden="true"></i>
				<p><%= t('chat:conversation.empty') %></p>
			</div>
		<% } %>
	</div>

	<% if (isRoomConversation) { %>
		<section
			id="chat-members-panel"
			class="chat-members-panel"
			aria-labelledby="chat-members-title"
			data-chat-members-panel
			hidden
		>
			<header class="chat-members-header">
				<div>
					<p class="chat-kicker"><%= t('chat:members.kicker') %></p>
					<h2 id="chat-members-title"><%= t('chat:members.title') %></h2>
				</div>
				<span class="chat-members-count">
					<%= t('chat:members.count', { count: roomMemberList.length }) %>
				</span>
			</header>

			<% if (roomMemberList.length > 0) { %>
				<ol class="chat-members-list">
					<% roomMemberList.forEach((member) => { %>
						<li class="chat-member-item">
							<span
								class="chat-member-avatar"
								style="background-color: <%= member.avatar?.background || '' %>;"
								aria-hidden="true"
							>
								<% if (member.avatar?.src) { %>
									<img src="<%= member.avatar.src %>" alt="" />
								<% } else { %>
									<%= getMemberName(member).slice(0, 1).toUpperCase() %>
								<% } %>
							</span>

							<div class="chat-member-body">
								<strong><%= getMemberName(member) %></strong>
								<div class="chat-member-badges">
									<span class="chat-member-badge chat-member-badge--<%= member.role %>">
										<%= t(`chat:members.roles.${member.role}`) %>
									</span>
									<% if (member.status === 'muted') { %>
										<span class="chat-member-badge chat-member-badge--muted">
											<%= t('chat:members.statuses.muted') %>
										</span>
									<% } %>
								</div>
							</div>
						</li>
					<% }) %>
				</ol>
			<% } else { %>
				<div class="chat-members-empty">
					<i class="bi bi-people" aria-hidden="true"></i>
					<p><%= t('chat:members.empty') %></p>
				</div>
			<% } %>
		</section>
	<% } %>

	<% if (isRoomConversation && canManageRoom) { %>
		<section
			id="chat-management-panel"
			class="chat-members-panel chat-management-panel"
			aria-labelledby="chat-management-title"
			data-chat-management-panel
			hidden
		>
			<header class="chat-members-header">
				<div>
					<p class="chat-kicker"><%= t('chat:members.manageKicker') %></p>
					<h2 id="chat-management-title"><%= t('chat:members.manageTitle') %></h2>
				</div>
				<span class="chat-members-count">
					<%= t('chat:members.count', { count: roomManagementMemberList.length }) %>
				</span>
			</header>

			<% if (managementGroups.length > 0) { %>
				<div class="chat-management-groups">
					<% managementGroups.forEach((group) => { %>
						<section class="chat-management-group">
							<h3><%= t(`chat:members.groups.${group.key}`) %></h3>
							<ol class="chat-members-list">
								<% group.members.forEach((member) => { %>
									<li class="chat-member-item chat-management-member-item">
										<span
											class="chat-member-avatar"
											style="background-color: <%= member.avatar?.background || '' %>;"
											aria-hidden="true"
										>
											<% if (member.avatar?.src) { %>
												<img src="<%= member.avatar.src %>" alt="" />
											<% } else { %>
												<%= getMemberName(member).slice(0, 1).toUpperCase() %>
											<% } %>
										</span>

										<div class="chat-member-body">
											<strong><%= getMemberName(member) %></strong>
											<div class="chat-member-badges">
												<span class="chat-member-badge chat-member-badge--<%= member.role %>">
													<%= t(`chat:members.roles.${member.role}`) %>
												</span>
												<% if (member.status !== 'active') { %>
													<span class="chat-member-badge chat-member-badge--<%= member.status %>">
														<%= t(`chat:members.statuses.${member.status}`) %>
													</span>
												<% } %>
											</div>
										</div>

										<div class="chat-management-actions">
											<% const memberActionForms = [
												{ show: canPromoteTarget(member), path: '/chat/rooms/members/promote', icon: 'bi-arrow-up-circle', label: 'promote' },
												{ show: canDemoteTarget(member), path: '/chat/rooms/members/demote', icon: 'bi-arrow-down-circle', label: 'demote' },
												{ show: canMuteTarget(member), path: '/chat/rooms/members/mute', icon: 'bi-volume-mute', label: 'mute' },
												{ show: canUnmuteTarget(member), path: '/chat/rooms/members/unmute', icon: 'bi-volume-up', label: 'unmute' },
												{ show: canRemoveTarget(member), path: '/chat/rooms/members/remove', icon: 'bi-person-dash', label: 'remove' },
												{ show: canBanTarget(member), path: '/chat/rooms/members/ban', icon: 'bi-slash-circle', label: 'ban' },
												{ show: canUnbanTarget(member), path: '/chat/rooms/members/unban', icon: 'bi-unlock', label: 'unban' },
												{ show: canDeleteTarget(member), path: '/chat/rooms/members/delete-history', icon: 'bi-trash3', label: 'deleteHistory', danger: true },
											].filter((item) => item.show); %>

											<% memberActionForms.forEach((action) => { %>
												<form method="POST" action="<%= action.path %>">
													<input type="hidden" name="conversationId" value="<%= conversation.id %>" />
													<input type="hidden" name="targetUserId" value="<%= member.id %>" />
													<button
														class="btn btn-action-outline chat-management-action has-tooltip <%= action.danger ? 'is-danger' : '' %>"
														type="submit"
														data-bs-title="<%= t(`chat:members.actions.${action.label}`) %>"
														aria-label="<%= t(`chat:members.actions.${action.label}`) %>"
													>
														<i class="bi <%= action.icon %>" aria-hidden="true"></i>
													</button>
												</form>
											<% }) %>
										</div>
									</li>
								<% }) %>
							</ol>
						</section>
					<% }) %>
				</div>
			<% } else { %>
				<div class="chat-members-empty">
					<i class="bi bi-gear" aria-hidden="true"></i>
					<p><%= t('chat:members.empty') %></p>
				</div>
			<% } %>
		</section>
	<% } %>

	<% if (isRoomConversation && canManageRoom) { %>
		<section
			id="chat-flags-panel"
			class="chat-members-panel chat-flags-panel"
			aria-labelledby="chat-flags-title"
			data-chat-flags-panel
			hidden
		>
			<header class="chat-members-header">
				<div>
					<p class="chat-kicker"><%= t('chat:flags.kicker') %></p>
					<h2 id="chat-flags-title"><%= t('chat:flags.title') %></h2>
				</div>
				<span class="chat-members-count" data-chat-flags-count>
					<%= formatFlagCountLabel(0) %>
				</span>
			</header>

			<ol class="chat-flags-list" data-chat-flags-list></ol>

			<div class="chat-members-empty" data-chat-flags-state>
				<i class="bi bi-flag" aria-hidden="true"></i>
				<p><%= t('chat:flags.empty') %></p>
			</div>

			<script type="application/json" data-chat-flag-count-labels>
				<%- JSON.stringify(flagCountLabels) %>
			</script>
		</section>
	<% } %>

	<% if (isRoomConversation && canManageRoom) { %>
		<section
			id="chat-activity-panel"
			class="chat-members-panel chat-activity-panel"
			aria-labelledby="chat-activity-title"
			data-chat-activity-panel
			hidden
		>
			<header class="chat-members-header">
				<div>
					<p class="chat-kicker"><%= t('chat:activity.kicker') %></p>
					<h2 id="chat-activity-title"><%= t('chat:activity.title') %></h2>
				</div>
				<span class="chat-members-count" data-chat-activity-count>
					<%= t('chat:count', { count: 0 }) %>
				</span>
			</header>

			<ol class="chat-activity-list" data-chat-activity-list></ol>

			<div class="chat-members-empty" data-chat-activity-state>
				<i class="bi bi-clock-history" aria-hidden="true"></i>
				<p><%= t('chat:activity.empty') %></p>
			</div>

			<button
				class="btn btn-action-outline chat-activity-load-more"
				type="button"
				data-chat-activity-load-more
				hidden
			>
				<%= t('chat:activity.loadMore') %>
			</button>

			<script type="application/json" data-chat-activity-labels>
				<%- JSON.stringify({
					join_request_approved: t('chat:activity.actions.joinRequestApproved'),
					join_request_rejected: t('chat:activity.actions.joinRequestRejected'),
					member_promoted: t('chat:activity.actions.memberPromoted'),
					admin_demoted: t('chat:activity.actions.adminDemoted'),
					member_muted: t('chat:activity.actions.memberMuted'),
					member_unmuted: t('chat:activity.actions.memberUnmuted'),
					member_removed: t('chat:activity.actions.memberRemoved'),
					member_banned: t('chat:activity.actions.memberBanned'),
					member_unbanned: t('chat:activity.actions.memberUnbanned'),
					member_history_deleted: t('chat:activity.actions.memberHistoryDeleted'),
					room_info_updated: t('chat:activity.actions.roomInfoUpdated'),
					message_flagged: t('chat:activity.actions.messageFlagged'),
					message_marked_safe: t('chat:activity.actions.messageMarkedSafe'),
					flagged_message_deleted: t('chat:activity.actions.flaggedMessageDeleted'),
					message_deleted_by_admin: t('chat:activity.actions.messageDeletedByAdmin'),
				}) %>
			</script>
		</section>
	<% } %>

	<div class="chat-typing-indicator" data-chat-typing-indicator hidden>
		<span></span>
	</div>

	<% if (!canWriteConversation) { %>
		<div class="chat-composer-notice" role="status" data-chat-composer-notice>
			<i class="bi bi-volume-mute-fill" aria-hidden="true"></i>
			<span><%= t('chat:conversation.mutedMessageError') %></span>
		</div>
	<% } %>

	<form
		class="chat-composer"
		method="POST"
		action="<%= messageFormAction %>"
		aria-label="<%= t('chat:conversation.composer') %>"
		data-chat-composer
	>
		<input
			class="form-control"
			type="text"
			name="message"
			maxlength="<%= messageBodyMaxLength %>"
			placeholder="<%= t('chat:conversation.placeholder') %>"
			autocomplete="off"
			required
			<% if (!canWriteConversation) { %>disabled<% } %>
		/>
		<button
			class="btn btn-action-secondary"
			type="submit"
			<% if (!canWriteConversation) { %>disabled<% } %>
		>
			<i class="bi bi-send" aria-hidden="true"></i>
			<span class="visually-hidden"><%= t('chat:conversation.send') %></span>
		</button>
	</form>
</section>

<% if (isRoomConversation && isRoomOwner) { %>
	<%- include('../modals/chat/_room_modal', {
		roomVisibility,
		roomModalMode: 'edit',
		roomModalAction: '/chat/rooms/update',
		roomModalValues: {
			name: room.title,
			description: room.description,
			keywords: room.keywords,
			visibility: room.visibility,
		},
	}) %>
<% } %>
