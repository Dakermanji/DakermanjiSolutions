<!--! views/chat/_conversation_message_meta.ejs -->
<div class="chat-message-meta">
	<% if (message.editedAt) { %>
		<span class="chat-message-edited">
			<span><%= t('chat:conversation.edited') %></span>
			<time datetime="<%= new Date(message.editedAt).toISOString() %>">
				<%= formatMessageTime(message.editedAt) %>
			</time>
		</span>
	<% } %>
	<div class="chat-message-time-actions">
		<% if (!message.isPendingReview) { %>
			<%- include('_conversation_message_reaction_picker', {
				extraReactions,
				message,
				quickReactions,
				reactionMessageUrl,
			}) %>
		<% } %>
		<time
			class="chat-message-time"
			datetime="<%= new Date(message.createdAt).toISOString() %>"
		>
			<%= formatMessageTime(message.createdAt) %>
		</time>
		<% if (message.isMine && !message.isPendingReview) { %>
			<button
				class="btn btn-action-outline chat-message-action chat-message-reply-inline has-tooltip"
				type="button"
				data-chat-message-reply
				data-bs-title="<%= t('chat:conversation.reply') %>"
				aria-label="<%= t('chat:conversation.reply') %>"
			>
				<i class="bi bi-reply" aria-hidden="true"></i>
			</button>
		<% } %>
	</div>
</div>
