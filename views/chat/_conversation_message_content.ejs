<!--! views/chat/_conversation_message_content.ejs -->
<div class="chat-message-content">
	<article class="chat-message-bubble">
		<% if (isRoomConversation && !message.isMine) { %>
			<header class="chat-message-sender-name">
				<%= getSenderName(message) %>
			</header>
		<% } %>
		<% if (message.replyTo) { %>
			<blockquote
				class="chat-message-reply"
				dir="auto"
				data-chat-message-reply-id="<%= message.replyTo.id %>"
			>
				<strong><%= getReplySenderName(message) %></strong>
				<span>
					<%= message.replyTo.isDeleted
						? t('chat:conversation.replyDeleted')
						: message.replyTo.bodyPreview %>
				</span>
			</blockquote>
		<% } %>
		<%
			const mentionUsernames = new Set(
				(message.mentions || [])
					.map((mention) => String(mention.username || '').toLowerCase())
					.filter(Boolean),
			);
			const messageBody = String(message.body || '');
			const mentionPattern = /(^|[^a-zA-Z0-9_.-])@([a-zA-Z0-9_.-]{3,20})(?=$|[^a-zA-Z0-9_.-])/g;
			const messageBodyParts = [];
			let mentionCursor = 0;
			let mentionMatch;

			while ((mentionMatch = mentionPattern.exec(messageBody))) {
				const prefix = mentionMatch[1] || '';
				const username = mentionMatch[2] || '';
				const mentionStart = mentionMatch.index + prefix.length;
				const mentionText = `@${username}`;

				if (mentionStart > mentionCursor) {
					messageBodyParts.push({ text: messageBody.slice(mentionCursor, mentionStart) });
				}

				messageBodyParts.push({
					text: mentionText,
					isMention: mentionUsernames.has(username.toLowerCase()),
				});
				mentionCursor = mentionStart + mentionText.length;
			}

			if (mentionCursor < messageBody.length) {
				messageBodyParts.push({ text: messageBody.slice(mentionCursor) });
			}
		%>
		<p class="chat-message-text" dir="auto"><% messageBodyParts.forEach((part) => { %><% if (part.isMention) { %><span class="chat-message-mention"><%= part.text %></span><% } else { %><%= part.text %><% } %><% }) %></p>
		<% if (message.isPendingReview) { %>
			<span class="chat-message-moderation-marker" data-chat-message-moderation-marker>
				<i class="bi bi-hourglass-split" aria-hidden="true"></i>
				<span><%= t('chat:conversation.waitingApproval') %></span>
			</span>
		<% } %>
	</article>
	<%- include('_conversation_message_reaction_summary', { message }) %>
</div>
