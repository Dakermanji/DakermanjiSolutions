<!--! views/chat/main.ejs -->
<%
	const sections = [
		{
			id: 'friends',
			icon: 'bi-person-hearts',
			count: chatSectionCounts?.friends || 0,
			expanded: true,
			url: '/chat/friends',
			canOpenSelfChat: true,
		},
		{
			id: 'privateRooms',
			icon: 'bi-shield-lock-fill',
			count: chatSectionCounts?.privateRooms || 0,
			expanded: false,
			url: '/chat/rooms/private',
			canCreateRoom: true,
			defaultRoomVisibility: roomVisibility.PRIVATE_UNLISTED,
		},
		{
			id: 'publicRooms',
			icon: 'bi-megaphone-fill',
			count: chatSectionCounts?.publicRooms || 0,
			expanded: false,
			url: '/chat/rooms/public',
			canCreateRoom: true,
			defaultRoomVisibility: roomVisibility.PUBLIC,
		},
	];
%>

<section
	class="chat-page"
	aria-labelledby="chat-title"
	<% if (activeChatConversationId) { %>
		data-active-conversation-id="<%= activeChatConversationId %>"
	<% } %>
>
	<header class="chat-header">
		<div>
			<p class="chat-kicker"><%= t('chat:kicker') %></p>
			<h1 id="chat-title"><%= t('chat:title') %></h1>
		</div>
		<button
			class="chat-status chat-search-rooms-button"
			type="button"
			aria-label="<%= t('chat:searchRooms') %>"
		>
			<i class="bi bi-search" aria-hidden="true"></i>
			<span><%= t('chat:searchRooms') %></span>
		</button>
	</header>

	<div class="accordion chat-accordion" id="chatSections">
		<% sections.forEach((section) => { %>
			<%
				const title = t(`chat:sections.${section.id}.title`);
				const description = t(`chat:sections.${section.id}.description`);
				const empty = t(`chat:sections.${section.id}.empty`);
				const isFriendsSection = section.id === 'friends';
				const isRoomsSection = section.id === 'privateRooms' || section.id === 'publicRooms';
				const headingId = `chat-${section.id}-heading`;
				const panelId = `chat-${section.id}-panel`;
				const bodyId = `chat-${section.id}-body`;
			%>
			<article class="accordion-item chat-section">
				<h2 class="accordion-header chat-section-header" id="<%= headingId %>">
					<button
						class="accordion-button <%= section.expanded ? '' : 'collapsed' %>"
						type="button"
						data-bs-toggle="collapse"
						data-bs-target="#<%= panelId %>"
						aria-expanded="<%= section.expanded ? 'true' : 'false' %>"
						aria-controls="<%= panelId %>"
					>
						<span class="chat-section-icon">
							<i class="bi <%= section.icon %>" aria-hidden="true"></i>
						</span>
						<span class="chat-section-heading">
							<span><%= title %></span>
							<small><%= description %></small>
						</span>
					</button>
					<span
						class="chat-section-count"
						<% if (isFriendsSection || isRoomsSection) { %>
							data-chat-count-section="<%= section.id %>"
						<% } %>
					>
						<%= t('chat:count', { count: section.count }) %>
					</span>
					<% if (section.canOpenSelfChat) { %>
						<button
							class="btn btn-action-outline chat-header-action has-tooltip"
							type="button"
							data-bs-title="<%= t('chat:selfChat') %>"
							aria-label="<%= t('chat:selfChat') %>"
						>
							<i class="bi bi-journal-text" aria-hidden="true"></i>
						</button>
					<% } %>
					<% if (section.canCreateRoom) { %>
						<button
							class="btn btn-action-outline chat-header-action has-tooltip"
							type="button"
							data-bs-title="<%= t('chat:createRoom') %>"
							data-bs-toggle="modal"
							data-bs-target="#chatRoomModal"
							data-chat-room-visibility="<%= section.defaultRoomVisibility %>"
							aria-label="<%= t('chat:createRoom') %>"
						>
							<i class="bi bi-plus-lg" aria-hidden="true"></i>
						</button>
					<% } %>

				</h2>
				<div
					id="<%= panelId %>"
					class="accordion-collapse collapse <%= section.expanded ? 'show' : '' %>"
					aria-labelledby="<%= headingId %>"
					data-bs-parent="#chatSections"
					<% if (isFriendsSection || isRoomsSection) { %>
						data-chat-section-collapse="<%= section.id %>"
					<% } %>
				>
					<div
						id="<%= bodyId %>"
						class="accordion-body"
						<% if (isFriendsSection || isRoomsSection) { %>
							data-chat-section-body="<%= section.id %>"
							data-url="<%= section.url %>"
							data-icon-class="<%= section.icon %>"
							data-loading-label="<%= t('chat:states.loading') %>"
							data-empty-label="<%= empty %>"
							data-error-label="<%= t('chat:states.error') %>"
							data-unread-label="<%= t('chat:unreadMessages') %>"
							<% if (isRoomsSection) { %>
								data-open-url="/chat/rooms/open"
								data-open-label="<%= t('chat:openChat') %>"
							<% } %>
							<% if (isFriendsSection) { %>
								data-open-label="<%= t('chat:openChat') %>"
								data-friend-fallback-label="<%= t('chat:friendFallback') %>"
								data-open-url="/chat/friends/open"
							<% } %>
						<% } %>
					>
						<div class="chat-empty-state">
							<i class="bi <%= section.icon %>" aria-hidden="true"></i>
							<p><%= empty %></p>
						</div>
					</div>
				</div>
			</article>
		<% }) %>
	</div>
</section>

<%- include('../modals/chat/_room_modal', { roomVisibility }) %>
