<!--! views/chat/_conversation_header.ejs -->
<header class="chat-conversation-header">
	<form method="POST" action="/chat/friends/close" class="chat-back-form">
		<%- include('../partials/_csrf') %>
		<button
			class="btn btn-action-outline chat-back-button has-tooltip"
			type="submit"
			data-bs-title="<%= t('chat:backToChats') %>"
			aria-label="<%= t('chat:backToChats') %>"
		>
			<i class="bi bi-arrow-left" aria-hidden="true"></i>
		</button>
	</form>

	<span class="chat-conversation-avatar-wrap">
		<span
			class="chat-conversation-avatar"
			style="background-color: <%= isRoomConversation ? '' : (friend.avatar?.background || '') %>;"
			aria-hidden="true"
		>
			<% if (!isRoomConversation && friend.avatar?.src) { %>
				<img src="<%= friend.avatar.src %>" alt="" />
			<% } else { %>
				<%= conversationName.slice(0, 1).toUpperCase() %>
			<% } %>
		</span>
		<% if (!isNotesConversation && !isRoomConversation) { %>
			<%
				const friendPresenceStatus = Object.values(presenceStatuses).includes(friend.status)
					? friend.status : presenceStatuses.OFFLINE;
				const friendPresenceLabel = t('presence.statuses.' + friendPresenceStatus);
			%>
			<span class="presence-dot chat-conversation-friend-presence has-tooltip"
				data-chat-conversation-friend-presence="<%= friend.id %>"
				data-presence-labels="<%= JSON.stringify(Object.fromEntries(Object.values(presenceStatuses).map(status => [status, t('presence.statuses.' + status)]))) %>"
				data-status="<%= friendPresenceStatus %>"
				data-bs-title="<%= friendPresenceLabel %>"
				role="img" aria-label="<%= friendPresenceLabel %>" tabindex="0"></span>
		<% } %>
	</span>

	<div class="chat-conversation-title">
		<p class="chat-kicker"><%= conversationKicker %></p>
		<h1 id="chat-conversation-title" dir="auto"><%= conversationName %></h1>
	</div>

	<% if (isNotesConversation || isRoomConversation) { %>
		<div class="chat-conversation-actions">
			<% if (isNotesConversation) { %>
				<button
					class="btn btn-action-outline chat-panel-toggle chat-danger-header-button has-tooltip"
					type="button"
					data-bs-toggle="modal"
					data-bs-target="#chatNotesResetModal"
					data-bs-title="<%= t('chat:notes.reset') %>"
					aria-label="<%= t('chat:notes.reset') %>"
				>
					<i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
				</button>
			<% } %>

			<% if (isRoomConversation) { %>
				<% if (canLeaveRoom) { %>
					<button
						class="btn btn-action-outline chat-panel-toggle chat-danger-header-button has-tooltip"
						type="button"
						data-bs-toggle="modal"
						data-bs-target="#chatRoomLeaveModal"
						data-chat-room-leave-button
						data-conversation-id="<%= conversation.id %>"
						data-room-name="<%= conversationName %>"
						data-bs-title="<%= t('chat:rooms.actions.leave') %>"
						aria-label="<%= t('chat:rooms.actions.leave') %>"
					>
						<i class="bi bi-box-arrow-right" aria-hidden="true"></i>
					</button>
				<% } %>
				<% if (isRoomOwner) { %>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-bs-toggle="modal"
						data-bs-target="#chatRoomModal"
						data-bs-title="<%= t('chat:rooms.infoToggle') %>"
						aria-label="<%= t('chat:rooms.infoToggle') %>"
					>
						<i class="bi bi-info-circle-fill" aria-hidden="true"></i>
					</button>
				<% } %>
				<% if (canManageRoom) { %>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-chat-flags-toggle
						data-bs-title="<%= t('chat:flags.toggle') %>"
						aria-label="<%= t('chat:flags.toggle') %>"
						aria-controls="chat-flags-panel"
						aria-expanded="false"
					>
						<i class="bi bi-flag-fill" aria-hidden="true"></i>
					</button>
					<button
						class="btn btn-action-outline chat-panel-toggle has-tooltip"
						type="button"
						data-chat-activity-toggle
						data-bs-title="<%= t('chat:activity.toggle') %>"
						aria-label="<%= t('chat:activity.toggle') %>"
						aria-controls="chat-activity-panel"
						aria-expanded="false"
					>
						<i class="bi bi-clock-history" aria-hidden="true"></i>
					</button>
				<% } %>
				<button
					class="btn btn-action-outline chat-panel-toggle has-tooltip"
					type="button"
					data-chat-members-toggle
					data-bs-title="<%= t('chat:members.toggle') %>"
					aria-label="<%= t('chat:members.toggle') %>"
					aria-controls="chat-members-panel"
					aria-expanded="false"
				>
					<i class="bi bi-people-fill" aria-hidden="true"></i>
				</button>
			<% } %>
		</div>
	<% } %>
</header>
