<!--! views/chat/_conversation_members_panel.ejs -->
<% if (isRoomConversation) { %>
	<section
		id="chat-members-panel"
		class="chat-members-panel"
		aria-labelledby="chat-members-title"
		data-chat-members-panel
		hidden
	>
		<header class="chat-members-header">
			<div>
				<p class="chat-kicker"><%= t('chat:members.kicker') %></p>
				<h2 id="chat-members-title"><%= t('chat:members.title') %></h2>
			</div>
			<span class="chat-members-count">
				<%= t('chat:members.count', { count: roomManagementMemberList.length || roomMemberList.length }) %>
			</span>
		</header>

		<% if (canManageRoom) { %>
			<form class="chat-members-invite" method="POST" action="/chat/rooms/invitations">
				<input type="hidden" name="conversationId" value="<%= conversation.id %>" />
				<label class="visually-hidden" for="chat-room-invite-username">
					<%= t('chat:members.inviteLabel') %>
				</label>
				<div class="input-group" dir="ltr">
					<span class="input-group-text" aria-hidden="true">@</span>
					<input
						id="chat-room-invite-username"
						class="form-control"
						type="text"
						name="targetUsername"
						placeholder="<%= t('chat:members.invitePlaceholder') %>"
						autocomplete="off"
						autocapitalize="none"
						dir="ltr"
						spellcheck="false"
						minlength="3"
						maxlength="20"
						pattern="[A-Za-z0-9_.-]{3,20}"
						required
					/>
					<button
						class="btn btn-action-outline chat-members-invite-submit has-tooltip"
						type="submit"
						data-bs-title="<%= t('chat:members.actions.invite') %>"
						aria-label="<%= t('chat:members.actions.invite') %>"
					>
						<i class="bi bi-person-plus" aria-hidden="true"></i>
					</button>
				</div>
			</form>
		<% } %>

		<% const visibleGroups = canManageRoom ? managementGroups : [{ key: null, members: roomMemberList }]; %>
		<% if (visibleGroups.some((group) => group.members.length > 0)) { %>
			<div class="chat-management-groups">
				<% visibleGroups.forEach((group) => { %>
					<% if (group.members.length > 0) { %>
						<section class="chat-management-group">
							<% if (group.key) { %>
								<h3><%= t(`chat:members.groups.${group.key}`) %></h3>
							<% } %>
							<ol class="chat-members-list">
								<% group.members.forEach((member) => { %>
									<% const social = member.social || {}; %>
									<% const canShowSocialAction = member.id !== user.id
										&& Boolean(member.username)
										&& ['active', 'muted'].includes(member.status)
										&& !social.isFollowing
										&& !social.isBlocked
										&& !social.isBlocking; %>
									<% const canRequestFollow = canShowSocialAction && !social.hasPendingFollowRequest; %>
									<% const followActionLabel = social.isFollower || social.hasPendingIncomingFollowRequest
										? 'followBack'
										: 'follow'; %>
									<% const memberActionForms = canManageRoom ? [
										{ show: canPromoteTarget(member), path: '/chat/rooms/members/promote', icon: 'bi-arrow-up-circle', label: 'promote' },
										{ show: canDemoteTarget(member), path: '/chat/rooms/members/demote', icon: 'bi-arrow-down-circle', label: 'demote' },
										{ show: canMuteTarget(member), path: '/chat/rooms/members/mute', icon: 'bi-volume-mute', label: 'mute' },
										{ show: canUnmuteTarget(member), path: '/chat/rooms/members/unmute', icon: 'bi-volume-up', label: 'unmute' },
										{ show: canRemoveTarget(member), path: '/chat/rooms/members/remove', icon: 'bi-person-dash', label: 'remove' },
										{ show: canBanTarget(member), path: '/chat/rooms/members/ban', icon: 'bi-slash-circle', label: 'ban' },
										{ show: canUnbanTarget(member), path: '/chat/rooms/members/unban', icon: 'bi-unlock', label: 'unban' },
										{ show: canDeleteTarget(member), path: '/chat/rooms/members/delete-history', icon: 'bi-trash3', label: 'deleteHistory', danger: true },
									].filter((item) => item.show) : []; %>
									<% const hasRowActions = canShowSocialAction || memberActionForms.length > 0; %>
									<li class="chat-member-item <%= hasRowActions ? 'chat-management-member-item' : '' %>">
										<span
											class="chat-member-avatar"
											style="background-color: <%= member.avatar?.background || '' %>;"
											aria-hidden="true"
										>
											<% if (member.avatar?.src) { %>
												<img src="<%= member.avatar.src %>" alt="" />
											<% } else { %>
												<%= getMemberName(member).slice(0, 1).toUpperCase() %>
											<% } %>
										</span>

										<div class="chat-member-body">
											<strong><%= getMemberName(member) %></strong>
											<div class="chat-member-badges">
												<span class="chat-member-badge chat-member-badge--<%= member.role %>">
													<%= t(`chat:members.roles.${member.role}`) %>
												</span>
												<% if (member.status !== 'active') { %>
													<span class="chat-member-badge chat-member-badge--<%= member.status %>">
														<%= t(`chat:members.statuses.${member.status}`) %>
													</span>
												<% } %>
											</div>
										</div>

										<% if (hasRowActions) { %>
											<div class="chat-management-actions">
												<% if (canRequestFollow) { %>
													<form method="POST" action="/social/follow-request">
														<input type="hidden" name="identifier" value="<%= member.username %>" />
														<input type="hidden" name="returnTo" value="/chat?conversation=active" />
														<button
															class="btn btn-action-outline chat-management-action chat-member-social-action has-tooltip"
															type="submit"
															data-bs-title="<%= t(`chat:members.actions.${followActionLabel}`) %>"
															aria-label="<%= t(`chat:members.actions.${followActionLabel}`) %>"
														>
															<i class="bi bi-person-plus" aria-hidden="true"></i>
														</button>
													</form>
												<% } else if (canShowSocialAction && social.hasPendingFollowRequest) { %>
													<span class="chat-member-social-badge">
														<%= t('chat:members.actions.followRequested') %>
													</span>
												<% } %>
												<% memberActionForms.forEach((action) => { %>
													<form method="POST" action="<%= action.path %>">
														<input type="hidden" name="conversationId" value="<%= conversation.id %>" />
														<input type="hidden" name="targetUserId" value="<%= member.id %>" />
														<button
															class="btn btn-action-outline chat-management-action has-tooltip <%= action.danger ? 'is-danger' : '' %>"
															type="submit"
															data-bs-title="<%= t(`chat:members.actions.${action.label}`) %>"
															aria-label="<%= t(`chat:members.actions.${action.label}`) %>"
														>
															<i class="bi <%= action.icon %>" aria-hidden="true"></i>
														</button>
													</form>
												<% }) %>
											</div>
										<% } %>
									</li>
								<% }) %>
							</ol>
						</section>
					<% } %>
				<% }) %>
			</div>
		<% } else { %>
			<div class="chat-members-empty">
				<i class="bi bi-people" aria-hidden="true"></i>
				<p><%= t('chat:members.empty') %></p>
			</div>
		<% } %>
	</section>
<% } %>