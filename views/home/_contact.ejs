<!--! views/home/_contact.ejs -->
<% const contact = t('home:contact') %>
<section id="contact" class="contact-section section-spacing">
	<div class="container">
		<div class="section-heading text-center mb-4">
			<h2><%= contact.title %></h2>
			<p class="contact-intro"><%= contact.description %></p>
		</div>

		<% if (!user) { %>
			<div class="contact-guest-message text-center div-1">
				<p><%= contactPhone ? contact.guest_message_with_phone : contact.guest_message %></p>

				<div class="contact-actions">
					<a
						href="mailto:<%= email %>"
						class="btn btn-action"
						aria-label="<%= contact.email.aria %>"
					>
						<i class="bi bi-envelope-at" aria-hidden="true"></i>
						<%= contact.email.label %>
					</a>
					<% if (contactPhone) { %>
						<a
							href="<%= contactPhoneHref %>"
							class="btn btn-action-outline"
							aria-label="<%= contact.phone.aria %> <%= contactPhone %>"
						>
							<i class="bi bi-telephone" aria-hidden="true"></i>
							<%= contact.phone.label %> <span dir="ltr"><%= contactPhone %></span>
						</a>
					<% } %>
				</div>
			</div>
		<% } else { %>
			<form id="contact-form" class="contact-form div-1" method="post" action="/contact">
				<%- include('../partials/_csrf') %>
				<div class="col-12 div-2">
					<label for="subject" class="form-label"><%= contact.form.subject.label %></label>
					<input
						type="text"
						class="form-control"
						id="subject"
						name="subject"
						placeholder="<%= contact.form.subject.placeholder %>"
						required
						maxlength="150"
					>
				</div>

				<div class="col-12 div-2">
					<label for="message" class="form-label"><%= contact.form.message.label %></label>
					<textarea
						class="form-control"
						id="message"
						name="message"
						rows="6"
						placeholder="<%= contact.form.message.placeholder %>"
						required
						maxlength="2000"
					></textarea>
				</div>

				<div class="col-12 contact-actions">
					<button type="submit" class="btn btn-action" aria-label="<%= contact.form.submit %>">
						<i class="bi bi-send" aria-hidden="true"></i>
						<%= contact.form.submit %>
					</button>
					<% if (contactPhone) { %>
						<a
							href="<%= contactPhoneHref %>"
							class="btn btn-action-outline"
							aria-label="<%= contact.phone.aria %> <%= contactPhone %>"
						>
							<i class="bi bi-telephone" aria-hidden="true"></i>
							<%= contact.phone.label %> <span dir="ltr"><%= contactPhone %></span>
						</a>
					<% } %>
				</div>
			</form>
		<% } %>
	</div>
</section>
