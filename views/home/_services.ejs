<!--! views/home/_services.ejs -->
<%
	const services = t('home:services', { returnObjects: true });
	const serviceItems = ['web', 'backend', 'api', 'database'].map((key) => services[key]);
%>

<section id="services">
	<div class="container">
		<div class="row justify-content-center text-center mb-4">
			<div class="col-12 col-lg-8">
				<h2><%= services.title %></h2>
			</div>
		</div>

		<div class="row g-4 justify-content-center">
			<% serviceItems.forEach((service) => { %>
				<div class="col-12 col-md-6 col-xl-3">
					<article class="service-card h-100">
						<span class="service-icon" aria-hidden="true"><i class="bi <%= service.icon %>"></i></span>
						<h3 class="h4 service-title"><%= service.title %></h3>
						<p class="service-description"><%= service.description %></p>
					</article>
				</div>
			<% }) %>
		</div>
	</div>
</section>
