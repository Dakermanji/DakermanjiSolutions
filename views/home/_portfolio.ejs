<!--! views/home/_portfolio.ejs -->
<% const portfolio = t('home:portfolio', { returnObjects: true }) %>

<section id="portfolio">
	<div class="container">
		<div class="portfolio-background">
			<div class="row g-4 align-items-stretch">
				<div class="col-12">
					<h2 class="text-center"><%= portfolio.title %></h2>
				</div>
			</div>

			<div class="row g-4 align-items-stretch div-1" id="portfolio-grid">
				<% Object.entries(portfolio.items || {}).forEach(([key, item]) => { %>
					<%
						if (!item) return;
						const isExternal = typeof item.link === 'string' && item.link.startsWith('https://');
						const projectHref = isExternal ? item.link : `/${item.link}`;
						const buttonLabel = isExternal ? portfolio.visit_website : portfolio.view;

						const images = item.images && typeof item.images === 'object' && !Array.isArray(item.images)
							? Object.entries(item.images)
							: [];
						const imageEntries = images;
					%>

					<div class="col-12 col-md-6 col-lg-4 col-xl-3 portfolio-item">
						<article
							class="card h-100 border-0 div-2"
							data-project="<%= key %>"
							data-images-count="<%= imageEntries.length %>"
						>
							<div
								class="portfolio-media position-relative overflow-hidden"
								data-slides="<%= imageEntries.length %>"
								data-interval="2200"
							>
								<% imageEntries.forEach(([imageName, imageAlt], index) => { %>
									<img
										src="/images/home/portfolio/<%= key %>/<%= imageName %>_<%= currentLang %>.jpg"
										class="portfolio-image <%= index === 0 ? 'active' : '' %>"
										alt="<%= imageAlt %>"
										loading="lazy"
										<%= index === 0 ? '' : 'aria-hidden="true"' %>
									/>
								<% }) %>
								<% if (!imageEntries.length) { %>
									<div class="d-flex h-100 align-items-center justify-content-center" aria-hidden="true">
										<i class="bi bi-window display-1"></i>
									</div>
								<% } %>

								<% if (imageEntries.length > 1) { %>
									<div class="portfolio-dots" aria-hidden="true">
										<% imageEntries.forEach((_, index) => { %>
											<span
												class="portfolio-dot <%= index === 0 ? 'active' : '' %>"
												data-slide-index="<%= index %>"
											></span>
										<% }) %>
									</div>
								<% } %>
							</div>

							<div class="card-body d-flex flex-column">
								<h3 class="card-title h4 mb-3"><%= item.title %></h3>

								<p class="card-text mb-3"><%= item.description %></p>

								<% if (Array.isArray(item.tech) && item.tech.length) { %>
									<ul class="p-0 list-inline mb-4 portfolio-tech-list">
										<% item.tech.forEach((tech) => { %>
											<li class="list-inline-item portfolio-tech-badge"><%= tech %></li>
										<% }) %>
									</ul>
								<% } %>

								<div class="mt-auto mx-auto">
									<% if (!isAuthenticated && !isExternal) { %>
										<p class="small text-center mb-2"><%= portfolio.login_required %></p>
									<% } %>
									<a
										href="<%= projectHref %>"
										<% if (!isAuthenticated && !isExternal) { %>
											data-bs-toggle="modal" data-bs-target="#authModal"
											data-app-return-to="/<%= item.link %>"
										<% } %>
										class="btn btn-action-secondary px-4"
										aria-label="<%= `${buttonLabel} - ${item.title}` %>"
									>
										<%= buttonLabel %>
									</a>
								</div>
							</div>
						</article>
					</div>
				<% }) %>

				<div class="col-12 col-md-6 col-lg-4 col-xl-3 portfolio-item">
					<article class="card h-100 border-0 portfolio-card--placeholder div-2">
						<div class="portfolio-media position-relative overflow-hidden">
							<img
								src="/images/home/portfolio/under_construction/<%= currentLang %>.png"
								class="portfolio-image active"
								alt="<%= portfolio.under_construction.alt %>"
								loading="lazy"
							/>
						</div>

						<div class="card-body d-flex flex-column justify-content-center text-center">
							<h3 class="card-title h4 mb-3">
								<%= portfolio.under_construction.title %>
							</h3>

							<p class="card-text mb-0">
								<%= portfolio.under_construction.soon %>
							</p>
						</div>
					</article>
				</div>
				<div class="btn-wrapper text-center">
					<button
						type="button"
						id="portfolio-show-more"
						class="btn btn-action-outline"
					>
						<%= portfolio.see_more_btn %>
					</button>
				</div>
			</div>
		</div>
	</div>
</section>
