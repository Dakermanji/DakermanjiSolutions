<!--! views/home/main.ejs -->
<div id="home-mouse-trail"></div>
<div id="cursor-follower"></div>
<div id="home-page" class="home-page">
	<div id="home-overlay" aria-hidden="true"></div>

	<!-- Hero Section -->
	<%- include('./_hero') %>

	<!-- About Section -->
	<%- include('./_about') %>

	<!-- Services Section -->
	<%- include('./_services') %>

	<!-- Portfolio Section -->
	<%- include('./_portfolio') %>

	<!-- Contact Section -->
	<%- include('./_contact') %>
</div>

<!-- Modals -->
<!-- Guest -->
<% if (!user) { %>
	<%- include('../modals/auth/_authTabs') %>
	<%- include('../modals/auth/_resetPassword') %>
<% } %>
<% if (!user || modal === 'recovery') { %>
	<%- include('../modals/auth/_recovery') %>
<% } %>
<% if (modal === 'complete_signup_local' || modal === 'complete_signup_oauth' ) { %>
	<%- include('../modals/auth/_complete_signup') %>
<% } %>
