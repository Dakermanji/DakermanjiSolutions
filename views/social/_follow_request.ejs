<!--! views/social/_follow_request.ejs -->
<section class="mb-3">
	<form
		action="/social/follow-request"
		method="POST"
		class="modal-form"
		novalidate
	>
		<%- include('../partials/_csrf') %>

		<label for="follow-request" class="form-label">
			<%= t('social:followRequest.title') %>
		</label>
		<input type="hidden" name="returnTo" value="<%= currentUrl %>">
		<input type="hidden" name="modalOnReturn" value="social">

		<div class="input-group">
			<input
				id="follow-request"
				class="form-control"
				name="identifier"
				type="text"
				aria-describedby="follow-request-error"
				placeholder="<%= t('social:followRequest.placeholder') %>"
				autocomplete="off"
				dir="ltr"
				required
				maxlength="254"
			/>

			<button type="submit" class="btn btn-primary" aria-label="<%= t('social:followRequest.title') %>">
				<i class="bi bi-person-plus" aria-hidden="true"></i>
			</button>
		</div>
		<div id="follow-request-error" class="text-danger small mt-1" role="alert" hidden>
			<%= t('social:error.invalid_identifier') %>
		</div>
	</form>
</section>
